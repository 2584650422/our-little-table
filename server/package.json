{
  "name": "little-table-server",
  "version": "1.0.0",
  "private": true,
  "description": "两个人的小饭桌 API",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch-path=src src/app.js",
    "dev:log": "mkdir -p logs && node --watch-path=src src/app.js 2>&1 | tee -a logs/dev.log",
    "logs": "tail -f logs/dev.log",
    "start": "node src/app.js",
    "check": "node --check src/app.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "qcloud-cos-sts": "^3.1.3"
  }
}
