NODE_ENV=development
PORT=3000
# 当前版本预留字段，暂不参与业务逻辑。
API_PUBLIC_URL=http://localhost:3000
# 首次测试也应修改。可运行：openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# ===== MySQL：首次启动必填 =====
# 本机 MySQL 通常填 127.0.0.1；Docker 中的 127.0.0.1 指容器自身，详见配置指南。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=little_table
# root 仅适合本地首次初始化；长期使用建议创建专用账号。
MYSQL_USER=root
# 填上面账号的真实密码；只有账号确实无密码时才留空。
MYSQL_PASSWORD=
# 两人应用 10 个连接足够，不等于数据库允许的最大连接数。
MYSQL_CONNECTION_LIMIT=10
# 数据库不可达时最多等待多久，避免 /health 长时间卡住。
MYSQL_CONNECT_TIMEOUT_MS=5000

# ===== 日志：应用只输出 stdout/stderr，由启动方式决定是否保存 =====
# debug / info / warn / error
LOG_LEVEL=info
# pretty 适合本地终端；json 适合 Docker/systemd/日志平台。
LOG_FORMAT=pretty

# ===== 微信登录：用微信开发者工具进入小程序时必填 =====
# 必须与 miniprogram/project.config.json 中的 appid 完全一致。
WECHAT_APP_ID=wx1e35ad5c79849fc0
# 小程序后台生成的 AppSecret，只能保存在服务端 .env。
WECHAT_APP_SECRET=

# ===== 微信订阅消息：首次核心流程测试可全部留空 =====
WECHAT_ORDER_TEMPLATE_ID=
# app.json 中存在的页面路径，不带开头斜杠。
WECHAT_ORDER_PAGE=pages/orders/orders
# 以下不是中文字段名，而是模板详情里的键，例如 thing1、date4；必须按真实模板填写。
WECHAT_TEMPLATE_MEAL_KEY=
WECHAT_TEMPLATE_DISH_KEY=
WECHAT_TEMPLATE_MESSAGE_KEY=
WECHAT_TEMPLATE_DATE_KEY=

# ===== 腾讯云 COS：不测试菜品图片上传时可全部留空 =====
# 建议使用 CAM 子账号密钥；永久密钥绝不能放到 miniprogram/。
COS_SECRET_ID=
COS_SECRET_KEY=
# 完整 Bucket 名，必须包含数字 APPID 后缀，例如 food-images-1251234567。
COS_BUCKET=
# 地域英文标识，例如 ap-shanghai，不是“上海”。
COS_REGION=
# 图片公开访问根地址，不带末尾 /。当前版本要求对象能够通过该地址读取。
COS_BASE_URL=
COS_UPLOAD_MAX_MB=5

# 仅用于 curl 等后端本地测试；小程序前端仍使用真实 wx.login。生产环境绝不能开启。
DEV_LOGIN_ENABLED=false
