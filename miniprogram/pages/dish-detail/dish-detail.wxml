<view class="prototype-page detail-page">
  <subpage-header/>
  <view wx:if="{{loading}}" class="loading">正在看看这道菜…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="media-hero cover" bindtap="preview"><image wx:if="{{dish.imageUrl}}" src="{{dish.imageUrl}}" mode="aspectFill"/><view wx:else class="media-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view><view wx:if="{{dish.imageUrl}}" class="expand">⤢</view></view>
    <view class="title-row"><view class="dish-title">{{dish.name}}</view><view class="heart" bindtap="favorite">{{dish.isFavorite?'♥':'♡'}}</view></view>
    <view class="dish-category">{{dish.categoryName}}</view>
    <view class="desc">{{dish.description||'这道菜还没有写介绍，喜欢就点它吧。'}}</view>
    <view class="tags"><text wx:for="{{dish.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
    <view class="prototype-card metric-card"><view class="metric"><view>{{dish.calorieLabel}}</view><text>热量</text></view><view class="metric"><view>{{dish.cookTimeMinutes?dish.cookTimeMinutes+' 分钟':'不用开火'}}</view><text>烹饪时间</text></view><view class="metric"><view>{{dish.difficultyLabel}}</view><text>难度</text></view><view class="metric"><view>{{dish.spicyLevel?'辣度 '+dish.spicyLevel+'/5':'不辣'}}</view><text>口味</text></view></view>
    <view class="history">一起吃过 {{dish.eatenCount||0}} 次 <text wx:if="{{dish.lastEatenAt}}">· 上次是 {{dish.lastEatenLabel}}</text></view>
    <view wx:if="{{dish.calorieKcal}}" class="calorie-note">热量是家庭做法的估算值，会因食材和份量而变化。</view>
    <view class="prototype-button prototype-fixed" bindtap="add">＋ 放进今天的小菜单</view>
  </block>
  <view wx:if="{{previewImageUrl}}" class="preview-mask" catchtap="closePreview"><view class="preview-content" catchtap="noop"><image src="{{previewImageUrl}}" mode="aspectFit"/><text catchtap="closePreview">×</text></view></view>
</view>
