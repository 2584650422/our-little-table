.detail-page{padding-bottom:180rpx}.cover{height:420rpx;aspect-ratio:auto;position:relative;margin-top:2rpx}.cover>image,.cover>.media-placeholder{display:block;width:100%;height:100%}.cover>.media-placeholder{display:flex}.expand{position:absolute;right:16rpx;bottom:15rpx;background:rgba(39,31,28,.67);color:#fff;border-radius:13rpx;padding:3rpx 10rpx;font-size:30rpx}.title-row{display:flex;align-items:center;justify-content:space-between;margin:25rpx 3rpx 3rpx}.dish-title{font-size:43rpx;line-height:1.3;font-weight:750;min-width:0;word-break:break-all}.heart{color:#D9787D;font-size:52rpx;line-height:1;padding:0 10rpx}.dish-category{font-size:25rpx;color:#77747C;margin:8rpx 4rpx}.desc{font-size:25rpx;line-height:1.65;color:#69656C;margin:18rpx 4rpx 12rpx;word-break:break-all}.tags{display:flex;flex-wrap:wrap;gap:9rpx;margin:10rpx 3rpx 23rpx}.tag{font-size:21rpx;padding:7rpx 15rpx}.metric-card{display:grid;grid-template-columns:1fr 1fr;gap:9rpx;padding:11rpx;margin-bottom:14rpx}.metric{background:#F8F7F6;border-radius:18rpx;min-height:105rpx;padding:18rpx 19rpx;box-sizing:border-box}.metric view{font-size:25rpx;font-weight:650;color:#252426;line-height:1.35;word-break:break-all}.metric text{display:block;font-size:21rpx;color:#89858C;margin-top:8rpx}.history{background:#F5F4F4;border-radius:18rpx;color:#78737C;font-size:23rpx;padding:19rpx 22rpx}.calorie-note{text-align:center;color:#AAA4A4;font-size:19rpx;margin-top:18rpx}.preview-mask{position:fixed;z-index:60;left:0;right:0;top:0;bottom:0;background:rgba(24,19,21,.89);display:flex;align-items:center;justify-content:center;padding:36rpx;box-sizing:border-box}.preview-content{width:100%;position:relative}.preview-content image{width:100%;height:70vh;border-radius:18rpx}.preview-content text{position:absolute;right:0;top:-64rpx;color:#fff;background:rgba(255,255,255,.19);border-radius:50%;width:52rpx;height:52rpx;line-height:47rpx;text-align:center;font-size:42rpx}
