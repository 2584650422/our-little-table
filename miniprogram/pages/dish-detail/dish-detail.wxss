.detail{padding-top:0;padding-bottom:190rpx;overflow-x:hidden}.cover{width:calc(100% + 56rpx);height:520rpx;margin-left:-28rpx;display:flex;align-items:center;justify-content:center;font-size:100rpx}.info-card{margin-top:-48rpx;position:relative;z-index:2;padding:32rpx 28rpx}.dish-heading{display:flex;align-items:flex-start;width:100%}.heading-copy{flex:1;min-width:0;padding-right:20rpx}.dish-title{font-size:38rpx;line-height:1.4;font-weight:700;color:#3F3438;word-break:break-all;overflow:visible}.dish-category{font-size:25rpx;line-height:1.5;color:#8A7E82;margin-top:8rpx}.heart{width:64rpx;height:64rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:50rpx;line-height:1;color:#E86F94}.desc{display:block;color:#8A7E82;font-size:27rpx;line-height:1.75;margin:24rpx 0;word-break:break-all;overflow:visible}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:34rpx}.grid>view{display:flex;flex-direction:column;gap:8rpx;min-width:0}.grid text{font-size:22rpx;line-height:1.5;color:#8A7E82}.grid .value{font-size:27rpx;line-height:1.5;color:#3F3438;font-weight:600;word-break:break-all}.grid .small{font-size:20rpx}.history{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22rpx;line-height:1.5}.history text{text-align:right;color:#A96379;word-break:break-all}.note{text-align:center;color:#B8ADB1;font-size:21rpx;line-height:1.6}.fixed{position:fixed;left:28rpx;right:28rpx;bottom:38rpx;width:calc(100% - 56rpx);z-index:9}
