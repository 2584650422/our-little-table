.photo-page {
  padding: 28rpx 32rpx calc(210rpx + env(safe-area-inset-bottom));
  color: #283b34;
}
.photo-empty {
  height: 440rpx;
  border: 2rpx dashed #afb7aa;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.photo-symbol {
  font-size: 72rpx;
  color: #60765b;
  font-weight: 300;
  line-height: 1.3;
}
.photo-empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 12rpx;
}
.photo-empty-note {
  font-size: 24rpx;
  color: #798279;
  margin-top: 14rpx;
}
.single-photo {
  position: relative;
}
.single-photo image {
  display: block;
  width: 100%;
  border-radius: 28rpx;
}
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.photo-tile {
  position: relative;
  height: 210rpx;
  background: #e7ecdd;
  border-radius: 18rpx;
  overflow: hidden;
}
.photo-tile image {
  width: 100%;
  height: 100%;
}
.photo-page .photo-remove {
  position: absolute;
  z-index: 2;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 60rpx !important;
  width: 60rpx !important;
  max-width: 60rpx;
  height: 60rpx;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50%;
  border: 2rpx solid rgba(66, 102, 79, 0.12);
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
  background: #fffef9;
  color: #42664f;
  box-shadow: 0 4rpx 14rpx rgba(34, 48, 39, 0.2);
}
.photo-page .photo-remove::after,
.save-action::after {
  border: 0;
}
.photo-meta {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 21rpx;
  color: #798279;
  margin: 18rpx 0 36rpx;
}
.photo-add {
  color: #42664f;
}
.section-heading {
  font-size: 28rpx;
  font-weight: 600;
  margin: 0 0 16rpx;
}
.info-card {
  background: #fffef9;
  border: 1rpx solid #e5e6dc;
  border-radius: 22rpx;
  padding: 0 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  font-size: 27rpx;
}
.date-row {
  border-top: 1rpx solid #e5e6dc;
}
.row-label {
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.placeholder,
.chevron {
  color: #798279;
}
.chevron {
  font-size: 38rpx;
  font-weight: 300;
}
.batch-note {
  font-size: 23rpx;
  color: #798279;
  line-height: 1.6;
  margin-top: 14rpx;
}
.note-heading {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.optional {
  font-size: 23rpx;
  font-weight: 400;
  color: #798279;
}
.note-input {
  box-sizing: border-box;
  width: 100%;
  height: 164rpx;
  background: #fffef9;
  border: 1rpx solid #e5e6dc;
  border-radius: 22rpx;
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
}
.permission-link {
  color: #42664f;
  font-size: 24rpx;
  padding: 12rpx 0;
}
.save-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #f7f5ee;
}
.save-hint {
  text-align: center;
  font-size: 23rpx;
  color: #798279;
  margin-bottom: 18rpx;
}
.save-action {
  width: 100%;
  padding: 20rpx 16rpx;
  margin: 0;
  background: #42664f;
  color: white;
  font-size: 28rpx;
  line-height: 1.5;
  border-radius: 20rpx;
}
.save-action[disabled] {
  background: #a7b7a1;
  color: #fffef9;
}

.photo-tile-active {
  outline: 4rpx solid #42664f;
  outline-offset: -4rpx;
}
.photo-number {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #fffef9e8;
  color: #42664f;
  font-size: 22rpx;
}
.metadata-hint {
  font-size: 23rpx;
  line-height: 1.7;
  color: #879286;
  margin: -8rpx 4rpx 18rpx;
}
.region-meta {
  font-size: 23rpx;
  line-height: 1.6;
  color: #879286;
  padding: 0 26rpx 18rpx;
}
.photo-current-preview {
  color: #42664f;
  font-size: 24rpx;
  text-align: right;
  padding: 12rpx 0;
}

.metadata-report-link {
  color: #42664f;
  display: inline-block;
  padding: 8rpx 4rpx;
}
