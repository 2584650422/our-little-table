page {
  background: #fff;
}
.home-page {
  background: #fff;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 155rpx;
}
.home-intro {
  position: relative;
  min-height: 160rpx;
  padding-top: 18rpx;
}
.greeting {
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.3;
  color: #262629;
}
.intro-line {
  max-width: 500rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8b898a;
  line-height: 1.5;
}
.hero-title {
  font-size: 54rpx;
  line-height: 1.25;
  letter-spacing: -1.3rpx;
  font-weight: 750;
  color: #1c1c1e;
  margin: 20rpx 0 28rpx;
}
.botanical {
  position: absolute;
  pointer-events: none;
}
.botanical-top {
  right: 0;
  top: 6rpx;
  width: 130rpx;
  height: 180rpx;
}
.botanical-circle {
  position: absolute;
  top: 0;
  right: 13rpx;
  width: 96rpx;
  height: 96rpx;
  background: #fff1df;
  border-radius: 50%;
}
.branch {
  position: absolute;
  left: 66rpx;
  top: 26rpx;
  width: 3rpx;
  height: 150rpx;
  background: #9c977d;
  transform: rotate(20deg);
  border-radius: 4rpx;
}
.leaf {
  position: absolute;
  width: 25rpx;
  height: 13rpx;
  background: #b5aa8e;
  border-radius: 100% 0 100% 0;
}
.leaf-1 {
  left: 48rpx;
  top: 39rpx;
  transform: rotate(30deg);
}
.leaf-2 {
  left: 72rpx;
  top: 67rpx;
  transform: rotate(145deg);
}
.leaf-3 {
  left: 37rpx;
  top: 94rpx;
  transform: rotate(35deg);
}
.leaf-4 {
  left: 76rpx;
  top: 122rpx;
  transform: rotate(145deg);
}
.feature-wrap {
  width: 100%;
}
.dish-swiper {
  height: 600rpx;
}
.feature-card {
  height: 600rpx;
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e8dfd8;
}
.feature-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #e8dfd8;
}
.feature-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 100rpx;
  color: #a9a09a;
}
.image-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(
    180deg,
    rgba(28, 20, 18, 0.38) 0%,
    rgba(28, 20, 18, 0) 38%,
    rgba(28, 20, 18, 0) 64%,
    rgba(28, 20, 18, 0.49) 100%
  );
}
.feature-copy {
  position: absolute;
  top: 34rpx;
  left: 34rpx;
  right: 34rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.22);
}
.feature-name {
  font-size: 37rpx;
  font-weight: 680;
  line-height: 1.3;
}
.feature-description {
  font-size: 24rpx;
  margin-top: 9rpx;
  opacity: 0.94;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.feature-foot {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 27rpx;
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 23rpx;
  text-shadow: 0 2rpx 7rpx rgba(0, 0, 0, 0.3);
}
.feature-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}
.feature-actions .btn {
  height: 90rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  margin: 0;
}
.shuffle-btn {
  width: 45%;
  background: #fbf4f2 !important;
  color: #3d3d40 !important;
  font-size: 27rpx;
}
.shuffle-icon {
  font-size: 33rpx;
  margin-right: 7rpx;
}
.choose-btn {
  flex: 1;
  background: #de7e80 !important;
  color: #fff !important;
  font-size: 29rpx;
}
.recommend-dots {
  height: 68rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e8dcda;
}
.dot.active {
  background: #d57778;
}
.home-reminder {
  position: relative;
  margin-top: 48rpx;
  min-height: 180rpx;
  padding: 28rpx 30rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #fcf7f0;
  overflow: hidden;
}
.reminder-label {
  font-size: 24rpx;
  color: #82736d;
  font-weight: 600;
}
.reminder-label text {
  color: #d97678;
  margin-right: 8rpx;
}
.reminder-copy {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #8c8380;
}
.botanical-note {
  right: 28rpx;
  bottom: -40rpx;
  width: 110rpx;
  height: 180rpx;
  opacity: 0.7;
  transform: rotate(20deg);
}
.bind-card,
.empty-recommend {
  text-align: center;
  padding: 70rpx 30rpx;
}
.big,
.empty-recommend-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.bind-card .btn,
.empty-recommend .btn {
  margin: 28rpx auto 0;
}
.empty-recommend-icon {
  font-size: 56rpx;
  color: #d98287;
}
.error .btn {
  margin-top: 24rpx;
}

.feature-placeholder {
  background: linear-gradient(180deg, #d8c9c0 0%, #f7f1ec 72%, #d9cec7 100%);
}
.feature-placeholder image {
  width: 150rpx;
  height: 150rpx;
  opacity: 0.73;
}
.shuffle-btn {
  background: #fcf4f3 !important;
}
.choose-btn {
  background: #de7f84 !important;
}
.dot.active {
  background: #de7f84;
}
.home-reminder {
  background: #fff9f2;
}
.reminder-label text {
  color: #de7f84;
}
.food-back {
  display: inline-flex;
  align-items: center;
  min-height: 58rpx;
  margin-bottom: 8rpx;
  color: #42664f;
  font-size: 25rpx;
  font-weight: 600;
}
