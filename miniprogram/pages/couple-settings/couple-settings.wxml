<view class="prototype-page settings-page">
  <subpage-header background="#F7F5EE"/>
  <view class="page-title">共同空间设置</view>
  <view class="page-caption">各自的资料，一起使用的空间。</view>
  <view wx:if="{{loading}}" class="life-empty">正在打开空间设置…</view>
  <view wx:elif="{{error && !couple}}" class="life-empty"><view>{{error}}</view><button class="life-button" bindtap="load">重新试试</button></view>
  <block wx:else>
    <view class="section-heading"><text>我的资料</text><text class="section-note">每人只修改自己的资料</text></view>
    <view class="settings-card">
      <view class="avatar-row" bindtap="chooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-editor" src="{{avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-editor avatar-fallback">{{nickname[0]||'我'}}</view>
        <view class="row-copy"><view>我的头像</view><text>{{uploadingAvatar?'正在处理照片…':'点击更换照片'}}</text></view><text class="arrow">›</text>
      </view>
      <view wx:if="{{avatarUrl && !saving && !uploadingAvatar}}" class="remove-avatar" bindtap="removeAvatar">恢复默认头像</view>
      <view class="field-row"><text>我的昵称</text><input disabled="{{saving}}" maxlength="30" value="{{nickname}}" data-key="nickname" bindinput="input" placeholder="填写昵称"/></view>
    </view>

    <view class="section-heading"><text>共同空间</text><text class="section-note">双方共享</text></view>
    <view class="settings-card">
      <view class="field-row first-row"><text>空间名称</text><input disabled="{{saving}}" maxlength="50" value="{{name}}" data-key="name" bindinput="input" placeholder="给共同空间起个名字"/></view>
      <view class="action-row bordered" bindtap="viewMembers"><view class="row-copy"><view>空间成员与邀请</view><text>{{couple.members.length}} / 2 位成员</text></view><view class="member-avatars"><block wx:for="{{couple.members}}" wx:key="id"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else>{{item.nickname[0]||'我'}}</view></block></view><text class="arrow">›</text></view>
    </view>

    <view class="section-heading"><text>空间管理</text></view>
    <view class="settings-card">
      <view class="action-row" bindtap="switchSpace"><view class="row-copy"><view>切换共同空间</view><text>查看已加入的空间，或创建新的空间</text></view><text class="arrow">›</text></view>
      <view class="action-row bordered" bindtap="toggleDanger"><view class="row-copy"><view>离开或删除共同空间</view><text>展开查看操作及影响</text></view><text class="arrow {{showDanger?'rotate':''}}">›</text></view>
      <view wx:if="{{showDanger}}" class="danger-panel bordered">
        <view class="danger-title">离开当前空间</view><view class="danger-note">只结束你与当前空间的成员关系，已有记录会保留。</view><button class="danger-action" disabled="{{saving || uploadingAvatar}}" bindtap="leave">离开当前空间</button>
        <view class="danger-title">永久删除共同空间</view><view class="danger-note">仅创建者且没有其他成员时可删除。空间内的菜单、用餐、日历和足迹记录都将删除。</view><button class="danger-action delete-action" disabled="{{saving || uploadingAvatar || !canDelete}}" bindtap="deleteSpace">永久删除共同空间</button>
      </view>
    </view>
    <view wx:if="{{error}}" class="life-error">{{error}}</view>
    <view class="settings-footer"><button class="life-button save-settings" bindtap="save" disabled="{{saving || uploadingAvatar}}" loading="{{saving}}">{{saving?'正在保存…':'保存设置'}}</button></view>
  </block>
</view>
