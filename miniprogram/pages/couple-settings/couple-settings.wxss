.form{padding:12rpx 26rpx 28rpx}.avatar-setting{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #F4E4EA}.avatar-editor{position:relative;width:112rpx;height:112rpx;flex-shrink:0;margin-right:22rpx;border-radius:50%;overflow:hidden}.avatar-editor image,.avatar-large{width:112rpx;height:112rpx;margin:0}.avatar-large{font-size:38rpx;line-height:112rpx}.avatar-mask{position:absolute;left:0;right:0;bottom:0;height:38rpx;line-height:38rpx;text-align:center;background:rgba(63,52,56,.62);color:#fff;font-size:19rpx}.avatar-copy{min-width:0}.avatar-copy>view{font-size:27rpx;color:#51464A}.avatar-copy>text{display:block;margin-top:7rpx;color:#A89CA0;font-size:21rpx;line-height:1.4}.avatar-copy .remove-avatar{color:#C45F7D}.field{display:flex;align-items:center;min-height:88rpx;padding:10rpx 0;border-bottom:1rpx solid #F4E4EA;box-sizing:border-box}.field>text{width:190rpx;flex-shrink:0;color:#756A6E;font-size:25rpx}.field input{flex:1;height:72rpx;line-height:72rpx;text-align:right}.field picker{flex:1;text-align:right}.copy-field{padding:24rpx 0;border-bottom:1rpx solid #F4E4EA}.copy-field>text{display:block;color:#756A6E;font-size:25rpx;line-height:1.5;margin-bottom:16rpx}.copy-field input{width:100%;height:84rpx;line-height:84rpx;box-sizing:border-box;padding:0 20rpx;background:#FFF8FA;border-radius:16rpx;font-size:26rpx}.copy-field textarea{display:block;width:100%;min-height:108rpx;box-sizing:border-box;padding:18rpx 20rpx;background:#FFF8FA;border-radius:16rpx;font-size:26rpx;line-height:1.65}.field-hint{margin-top:10rpx;color:#B8ADB1;font-size:21rpx;line-height:1.5}.form .btn{margin-top:26rpx}.members{padding:10rpx 24rpx}.member{display:flex;align-items:center;padding:18rpx 0}.avatar,.member-avatar{width:72rpx;height:72rpx;border-radius:50%;flex-shrink:0;margin-right:18rpx}.avatar{background:#FFDCE6;color:#A96379;line-height:72rpx;text-align:center;font-size:28rpx}.member-info{flex:1;min-width:0}.member-info>text{font-size:22rpx;line-height:1.5;color:#A89CA0}.me-tag{display:inline-block;margin-left:12rpx;padding:2rpx 10rpx;border-radius:999rpx;background:#FFF0F4;color:#C45F7D;font-size:19rpx}.invite{text-align:center}.label{color:#8A7E82}.code{font-size:46rpx;letter-spacing:8rpx;color:#E86F94;font-weight:700;margin:18rpx}.hint{font-size:22rpx;color:#B8ADB1}.invite-actions{display:flex;gap:16rpx;margin-top:24rpx}.invite-actions button{flex:1;background:#FFF0F4;color:#A96379;border-radius:999rpx;font-size:25rpx}.invite-actions button::after{border:0}.danger{margin-top:50rpx;padding:26rpx;color:#9B747F;font-size:23rpx;line-height:1.6}.danger-title{font-size:28rpx;color:#694D55;font-weight:600;margin-bottom:8rpx}.danger button{margin-top:22rpx;background:#FFF0F3;color:#C45F7D;border-radius:999rpx;font-size:25rpx}.danger button::after{border:0}
.avatar-editor .avatar-large{width:112rpx;height:112rpx;margin:0;font-size:38rpx;line-height:112rpx}
.copy-field .title-editor{min-height:84rpx}
.delete-title{margin-top:36rpx}.danger .delete-couple{background:#FFF0F3;color:#C45F7D}
.switch-table{display:flex;align-items:center;justify-content:space-between;font-size:26rpx;color:#51464A}.switch-table text:last-child{font-size:21rpx;color:#A38E95}
