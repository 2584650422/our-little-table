.settings-page {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #f7f5ee;
  color: #283b34;
  min-height: 100vh;
  box-sizing: border-box;
}
.page-title {
  font:
    500 48rpx Georgia,
    'Songti SC',
    serif;
  margin: 10rpx 0 12rpx;
  line-height: 1.4;
}
.page-caption {
  font-size: 24rpx;
  color: #798279;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 32rpx 4rpx 16rpx;
}
.section-note {
  font-size: 21rpx;
  color: #798279;
  font-weight: 400;
}
.settings-card {
  padding: 0 24rpx;
  background: #fffef9;
  border: 1rpx solid #e5e6dc;
  border-radius: 26rpx;
}
.avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 140rpx;
}
.avatar-editor {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avatar-fallback {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #e7ecdd;
  color: #42664f;
  font-size: 38rpx;
}
.row-copy {
  flex: 1;
  min-width: 0;
}
.row-copy > view {
  font-size: 27rpx;
  line-height: 1.6;
}
.row-copy > text {
  display: block;
  font-size: 22rpx;
  color: #798279;
  margin-top: 4rpx;
  line-height: 1.5;
}
.remove-avatar {
  font-size: 22rpx;
  color: #42664f;
  padding: 0 0 20rpx 112rpx;
}
.field-row {
  min-height: 100rpx;
  border-top: 1rpx solid #e5e6dc;
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 27rpx;
}
.first-row {
  border-top: 0;
}
.field-row > text {
  flex-shrink: 0;
}
.field-row input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 27rpx;
  height: 76rpx;
  color: #42664f;
}
.action-row {
  min-height: 110rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.bordered {
  border-top: 1rpx solid #e5e6dc;
}
.arrow {
  font-size: 38rpx;
  color: #798279;
  line-height: 1;
  transition: transform 0.2s;
  flex-shrink: 0;
}
.arrow.rotate {
  transform: rotate(90deg);
}
.member-avatars {
  display: flex;
  margin-left: 10rpx;
}
.member-avatars image,
.member-avatars view {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  margin-left: -10rpx;
  border: 3rpx solid #fffef9;
  box-sizing: border-box;
}
.member-avatars view {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e7ecdd;
  color: #42664f;
  font-size: 20rpx;
}
.danger-panel {
  padding: 8rpx 0 24rpx;
}
.danger-title {
  font-size: 26rpx;
  color: #975f4c;
  margin-top: 22rpx;
  font-weight: 500;
}
.danger-note {
  font-size: 23rpx;
  color: #798279;
  line-height: 1.7;
  margin: 10rpx 0 18rpx;
}
.settings-page .danger-action {
  width: 100%;
  padding: 18rpx;
  margin: 0 0 22rpx;
  line-height: 1.5;
  font-size: 25rpx;
  background: #f2e7df;
  color: #975f4c;
  border-radius: 18rpx;
}
.danger-action::after {
  border: 0;
}
.delete-action {
  background: #fffef9;
  border: 1rpx solid #d7ada0;
}
.settings-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #f7f5ee;
}
.settings-page .save-settings {
  width: 100%;
  max-width: none;
  box-sizing: border-box;
}
.save-settings[disabled] {
  background: #a7b7a1;
  color: #fffef9;
}
.settings-page .danger-action[disabled] {
  opacity: 0.45;
}
