.settings-page{padding-bottom:300rpx}
.page-title{font-size:54rpx;line-height:1.25;margin:2rpx 3rpx 9rpx}
.page-caption{font-size:23rpx;color:#969097;line-height:1.5;margin:0 3rpx 28rpx}
.section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:14rpx;margin:34rpx 4rpx 13rpx}
.section-heading view{font-size:32rpx;font-weight:720;color:#282528;white-space:nowrap}
.section-heading text{font-size:21rpx;color:#A09A9F;text-align:right;line-height:1.45}
.section-card,.copy-card,.danger-card{padding:7rpx 23rpx}
.prototype-card{border-radius:25rpx;box-shadow:0 8rpx 26rpx rgba(64,44,49,.038)}
.prototype-divider{background:#F1EDEE}

.avatar-row{min-height:142rpx;display:flex;align-items:center;gap:19rpx}
.avatar-editor{width:108rpx;height:108rpx;border-radius:50%;flex:none;overflow:hidden}
.avatar-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#F2E7E4;color:#9C777B;font-size:37rpx;font-weight:600}
.avatar-copy{flex:1;min-width:0}
.avatar-copy view{font-size:29rpx;font-weight:650;color:#343035}
.avatar-copy text{display:block;color:#98919A;font-size:23rpx;margin-top:7rpx}
.remove-avatar{font-size:22rpx;color:#C97880;padding:0 0 16rpx 127rpx}
.background-row{display:flex;align-items:center;gap:19rpx;min-height:138rpx}.background-thumb{width:122rpx;height:89rpx;flex:none;border-radius:14rpx;background:#F3EDE8}.background-copy{flex:1;min-width:0}.background-copy view{font-size:28rpx;font-weight:650;color:#343035}.background-copy text{display:block;color:#98919A;font-size:22rpx;margin-top:7rpx}.remove-background{font-size:22rpx;color:#C97880;padding:0 0 16rpx 141rpx}
.arrow{font-size:35rpx;color:#9A969C;line-height:1;flex:none;transition:transform .2s ease}
.arrow.rotate{transform:rotate(90deg)}

.field-row{min-height:90rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.field-row>text{font-size:28rpx;font-weight:610;color:#39343A;white-space:nowrap}
.field-row input{height:80rpx;min-width:0;flex:1;text-align:right;color:#5E5961;font-size:26rpx}
.field-row picker{text-align:right;color:#5E5961;font-size:26rpx}
.field-row picker .arrow{vertical-align:-2rpx;margin-left:4rpx}

.action-row{min-height:103rpx;display:flex;align-items:center;gap:12rpx}
.action-copy{flex:1;min-width:0}
.action-copy>text{display:block;color:#39343A;font-size:28rpx;font-weight:620}
.action-copy>view{font-size:22rpx;color:#9E969C;margin-top:5rpx}
.member-avatars{display:flex;align-items:center;margin-right:7rpx}
.member-avatars image,.member-avatars view{width:52rpx;height:52rpx;border-radius:50%;border:3rpx solid #fff;margin-left:-12rpx;box-sizing:border-box;background:#F3E7E3;display:flex;align-items:center;justify-content:center;color:#A7787D;font-size:22rpx}

.copy-card{padding-top:19rpx;padding-bottom:17rpx}
.copy-label{font-size:27rpx;font-weight:630;color:#39343A;margin-bottom:11rpx}
.copy-card textarea{box-sizing:border-box;width:100%;min-height:82rpx;border:1rpx solid #EEE9E9;border-radius:17rpx;background:#FCFBFA;padding:15rpx 17rpx;color:#5F5B65;font-size:26rpx;line-height:1.45;margin-bottom:16rpx}
.copy-card .prototype-divider{margin-bottom:17rpx}
.copy-card textarea:last-child{margin-bottom:0}
.management-card{margin-bottom:0}
.other-heading{margin-top:40rpx}
.danger-card{margin-bottom:0}
.danger-toggle .action-copy>text{color:#865F67}
.danger-panel{padding:0 0 26rpx;color:#91888E}
.danger-panel .prototype-divider{margin-bottom:24rpx}
.danger-title{font-size:26rpx;color:#5C5055;font-weight:650;margin-bottom:7rpx}
.danger-note{font-size:22rpx;line-height:1.55;color:#91888E}
.delete-title{margin-top:32rpx}
.danger-action{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:330rpx;height:68rpx;line-height:1;margin:16rpx auto 0;padding:0;border-radius:999rpx;background:#FAEFEF;color:#B96C75;font-size:24rpx;font-weight:600}
.danger-action::after{border:0}
.delete-action{background:#FFF7F6;border:1rpx solid #EBC9CC;color:#B65D69}
.error-state{text-align:center;padding:55rpx 25rpx}
.error-state .btn{margin-top:22rpx}
