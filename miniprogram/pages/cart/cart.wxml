<view class="prototype-page cart-page">
  <subpage-header/>
  <view class="prototype-title page-title">今天的小菜单</view>
  <block wx:if="{{items.length}}">
    <view class="prototype-card items-card">
      <view wx:for="{{items}}" wx:key="dishId" class="item"><image wx:if="{{item.imageUrl}}" class="media-thumb" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="media-thumb media-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view><view class="name">{{item.dishName}}</view><view class="counter"><text bindtap="change" data-index="{{index}}" data-delta="-1">−</text><text>{{item.quantity}}</text><text bindtap="change" data-index="{{index}}" data-delta="1">＋</text></view></view>
      <view class="summary"><text>已选 {{items.length}} 道菜</text><text wx:if="{{totalCalories}}">预计约 {{totalCalories}} kcal</text></view>
    </view>
    <view class="prototype-card schedule"><view class="schedule-title">这一顿怎么安排？</view><view class="field-row"><text>吃饭类型</text><picker range="{{mealTypes}}" range-key="n" value="{{mealIndex}}" bindchange="meal"><view>{{mealTypes[mealIndex].n}} <text class="arrow">›</text></view></picker></view><view class="prototype-divider"/><view class="field-row"><text>什么时候吃</text><picker mode="date" value="{{mealDate}}" bindchange="date"><view>{{mealDate}} <text class="arrow">›</text></view></picker></view><view class="merge-hint">同一餐次还有未上菜的菜单时，新选的菜会加到那一顿。</view></view>
    <view class="message-box"><view>给对方的话</view><textarea maxlength="300" placeholder="比如：不要太辣～" value="{{message}}" bindinput="message"/></view>
    <view wx:if="{{totalCalories}}" class="calorie-hint">热量只是家庭做法估算，吃得开心更重要。</view>
    <view class="prototype-button prototype-fixed" bindtap="submit">就吃这些啦</view>
  </block>
  <empty-state wx:else icon="🥣" title="好像还没想好吃什么" hint="回菜单看看，或者让命运帮我们选一个"/>
</view>
