<view class="page"><view wx:if="{{items.length}}"><view class="card item" wx:for="{{items}}" wx:key="dishId"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="thumb image-placeholder">🍽️</view><view class="info"><view class="name">{{item.dishName}}</view><view wx:if="{{item.calorieKcal}}" class="muted">约 {{item.calorieKcal*item.quantity}} kcal</view></view><view class="counter"><text bindtap="change" data-index="{{index}}" data-delta="-1">−</text><text>{{item.quantity}}</text><text bindtap="change" data-index="{{index}}" data-delta="1">＋</text></view></view><view class="section-title">这一顿怎么安排？</view><view class="card form"><view class="field between"><text>吃饭类型</text><picker range="{{mealTypes}}" range-key="n" value="{{mealIndex}}" bindchange="meal"><view class="pink">{{mealTypes[mealIndex].n}} ›</view></picker></view><view class="divider"/><view class="field between"><text>什么时候吃</text><picker mode="date" value="{{mealDate}}" bindchange="date"><view class="pink">{{mealDate}} ›</view></picker></view><view class="divider"/><view><view class="label">给对方的话</view><textarea maxlength="300" placeholder="比如：不要太辣～" value="{{message}}" bindinput="message"/></view></view><view wx:if="{{totalCalories}}" class="calorie">本次点单约 {{totalCalories}} kcal · 只是家庭做法估算</view><button class="btn submit" bindtap="submit">就吃这些啦</button></view><empty-state wx:else icon="🥣" title="好像还没想好吃什么" hint="回菜单看看，或者让命运帮我们选一个"/></view>
