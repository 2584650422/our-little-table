.cart-page {
  padding-bottom: 180rpx;
}
.page-title {
  margin: 4rpx 4rpx 26rpx;
}
.items-card {
  padding: 8rpx 16rpx;
  margin-bottom: 18rpx;
}
.item {
  display: flex;
  align-items: center;
  min-height: 137rpx;
  border-bottom: 1rpx solid #f0edeb;
}
.item:last-of-type {
  border-bottom: 0;
}
.item .media-thumb {
  width: 100rpx;
  height: 100rpx;
}
.name {
  font-size: 27rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.counter {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex: none;
}
.counter text:first-child,
.counter text:last-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #fcecea;
  color: #d6787d;
  font-size: 38rpx;
  line-height: 1;
}
.counter text:nth-child(2) {
  min-width: 25rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 650;
}
.summary {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 22rpx 9rpx 12rpx;
  font-size: 23rpx;
  color: #29272b;
}
.summary text:first-child {
  font-weight: 650;
}
.summary text:last-child {
  color: #827e88;
}
.schedule {
  padding: 15rpx 20rpx 0;
}
.schedule-title {
  font-size: 30rpx;
  font-weight: 730;
  margin: 8rpx 0 12rpx;
}
.field-row {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
}
.field-row picker {
  color: #37343a;
}
.arrow {
  font-size: 34rpx;
  color: #9b99a0;
  vertical-align: -2rpx;
  margin-left: 12rpx;
}
.message-box {
  background: #f7f5f4;
  border-radius: 22rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
}
.message-box > view {
  font-size: 25rpx;
  color: #59545b;
}
.message-box textarea {
  width: 100%;
  height: 100rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #29262b;
  margin-top: 12rpx;
}
.calorie-hint {
  font-size: 20rpx;
  color: #a9a3a4;
  text-align: center;
  margin-top: 16rpx;
}
.item {
  min-height: 150rpx;
}
.item .media-thumb {
  width: 122rpx;
  height: 122rpx;
}
.merge-hint {
  font-size: 22rpx;
  color: #9d9296;
  margin: 18rpx 2rpx 0;
  line-height: 1.5;
}
