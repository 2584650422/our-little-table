.item{display:flex;align-items:center}.item image,.thumb{width:112rpx;height:112rpx;border-radius:20rpx;flex:none}.info{flex:1;margin-left:20rpx}.name{font-weight:700;font-size:30rpx;margin-bottom:8rpx}.counter{display:flex;gap:20rpx;align-items:center;background:#FFF0F4;border-radius:999rpx;padding:10rpx 18rpx}.counter text:first-child,.counter text:last-child{font-size:34rpx;color:#E86F94}.form .field{margin:0}.form textarea{height:120rpx;background:#FFF9FB;border-radius:20rpx;padding:18rpx;box-sizing:border-box;width:100%}.calorie{text-align:center;color:#8A7E82;font-size:23rpx;margin:28rpx}.subscribe{background:transparent;color:#A96379;font-size:24rpx;margin-bottom:18rpx}.subscribe::after{border:0}.submit{width:100%}
