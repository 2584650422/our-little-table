page {
  height: 100%;
  overflow: hidden;
  background: #f7f5ee;
}
.explore {
  box-sizing: border-box;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding-right: 14px;
  padding-bottom: max(8px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  color: #283b34;
  background: #f7f5ee;
  font-family:
    system-ui,
    -apple-system,
    sans-serif;
}
.toolbar {
  position: relative;
  z-index: 2;
  height: 40px;
  flex: none;
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 6px;
  box-sizing: border-box;
}
.back {
  width: 30px;
  font-size: 34px;
  line-height: 32px;
  text-align: center;
}
.title {
  font-size: 18px;
  font-weight: 600;
  white-space: nowrap;
}
.crumb {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #718071;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.crumb text {
  padding: 8px 0;
}
.close {
  font-size: 11px;
  color: #42664f;
  white-space: nowrap;
  padding: 6px 10px;
  border-radius: 20px;
  background: #e7ecdd;
}
.content {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  border-radius: 22px;
  background: #e7ecdd;
}
.map-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
}
.album-open .map-panel {
  width: 100%;
}
.album-panel {
  position: absolute;
  left: 44%;
  right: 12px;
  top: 12px;
  bottom: 12px;
  padding: 12px;
  border-radius: 16px;
  background: #fffef9f2;
  box-sizing: border-box;
  z-index: 6;
  opacity: 0;
  transform: translateX(30px);
  pointer-events: none;
  transition:
    opacity 280ms ease,
    transform 420ms cubic-bezier(0.22, 0.7, 0.2, 1);
  display: flex;
  flex-direction: column;
}
.album-panel.visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}
.album-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 15px;
  font-weight: 600;
  gap: 12px;
  height: 28px;
  flex: none;
}
.album-count {
  font-size: 11px;
  font-weight: 400;
  color: #798279;
}
.footer {
  height: 25px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  font-size: 10px;
  color: #798279;
  gap: 10px;
}
@keyframes unfold {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.viewer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: #191d1b;
  color: #fffef9;
  display: flex;
  flex-direction: column;
  padding: 8px 18px max(8px, env(safe-area-inset-bottom)) max(44px, env(safe-area-inset-left));
  box-sizing: border-box;
  animation: unfold 220ms ease both;
}
.viewer-toolbar {
  height: 34px;
  flex: none;
  display: flex;
  align-items: center;
  gap: 18px;
  padding-right: 110px;
  font-size: 13px;
}
.viewer-close {
  font-size: 30px;
  width: 30px;
  text-align: center;
}
.viewer-status {
  font-size: 10px;
  color: #aab5aa;
}
.viewer-swiper {
  height: 0;
  flex: 1;
  min-height: 0;
  width: 100%;
}
.viewer-area,
.viewer-image-stage {
  width: 100%;
  height: 100%;
  position: relative;
}
.viewer-image {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.viewer-caption {
  height: 22px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: #dce4da;
}
.filmstrip {
  height: 42px;
  flex: none;
  white-space: nowrap;
}
.filmstrip-inner {
  display: flex;
  gap: 7px;
  height: 40px;
}
.film-photo {
  display: block;
  width: 54px;
  height: 36px;
  flex: none;
  border-radius: 3px;
  border: 2px solid transparent;
  opacity: 0.55;
  box-sizing: border-box;
}
.film-photo.active {
  border-color: #fffef9;
  opacity: 1;
}

.photo-arrow {
  position: absolute;
  top: 43%;
  width: 32px;
  height: 46px;
  line-height: 44px;
  text-align: center;
  font-size: 36px;
  border-radius: 18px;
  background: #fffef914;
  color: #fffef9;
}
.photo-arrow.previous {
  left: max(46px, env(safe-area-inset-left));
}
.photo-arrow.next {
  right: 18px;
}

.country-return {
  position: absolute;
  z-index: 5;
  left: 12px;
  top: 12px;
  padding: 6px 12px;
  border-radius: 20px;
  color: #42664f;
  background: #fffef9e8;
  font-size: 12px;
}

/* Keep the back icon geometrically aligned with the title, independent of font glyphs. */
.toolbar {
  gap: 10px;
}
.back {
  width: 28px;
  height: 32px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-chevron {
  width: 10px;
  height: 10px;
  border-left: 2px solid #283b34;
  border-bottom: 2px solid #283b34;
  transform: rotate(45deg);
}
.title {
  line-height: 32px;
}
.crumb {
  line-height: 32px;
}
.city-place-list {
  flex: 1;
  height: 0;
  min-height: 0;
}
.city-place-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  padding: 7px 2px 2px;
}
.city-place-card {
  min-width: 0;
  padding: 9px;
  border: 1px solid #e1e7db;
  border-radius: 11px;
  background: #f5f5ed;
}
.city-place-stack {
  position: relative;
  margin: 3px 7px 5px 2px;
}
.city-place-stack::before {
  content: '';
  position: absolute;
  inset: -3px -4px 3px 4px;
  border-radius: 5px;
  background: #dce6d6;
}
.city-place-cover {
  position: relative;
  display: block;
  width: 100%;
  height: 65px;
  box-sizing: border-box;
  border: 4px solid #fffef9;
  border-radius: 5px;
  background: #e7ecdd;
}
.city-place-count {
  position: absolute;
  right: -4px;
  bottom: -1px;
  padding: 2px 6px;
  border-radius: 10px;
  background: #42664f;
  color: #fffef9;
  font-size: 10px;
}
.city-place-name {
  font-size: 12px;
  color: #42664f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.city-place-date {
  margin-top: 3px;
  font-size: 10px;
  color: #68796d;
}
