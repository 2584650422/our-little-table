<view class="life-page thought-page">
  <view class="life-row"><view class="life-title">想你了</view><button class="life-button" bindtap="compose">＋ 发一句</button></view>
  <view class="thought-summary"><view class="summary-people"><image wx:if="{{me.avatarUrl}}" src="{{me.avatarUrl}}" mode="aspectFill"/><view wx:else>{{me.initial||'我'}}</view><text>与</text><image wx:if="{{partner.avatarUrl}}" src="{{partner.avatarUrl}}" mode="aspectFill"/><view wx:else>{{partner.initial||'你'}}</view><text>{{partner.nickname}}</text></view><view class="life-subtitle">{{recent?'最近一条 · '+recent:'有想说的话，就留在这里。'}}</view></view>
  <view class="thought-filters"><text class="{{filter==='all'?'active':''}}" data-filter="all" bindtap="filter">全部</text><text class="{{filter==='received'?'active':''}}" data-filter="received" bindtap="filter">收到的</text><text class="{{filter==='sent'?'active':''}}" data-filter="sent" bindtap="filter">发出的</text></view>
  <view wx:if="{{focused}}" class="focus-note" bindtap="all">正在查看指定记录 · 显示全部 →</view>
  <view wx:if="{{loading}}" class="life-empty">正在查看记录…</view><view wx:elif="{{error}}" class="life-error" bindtap="load">{{error}} · 点击重试</view>
  <view wx:if="{{!loading && !error && !items.length}}" class="life-empty">还没有留言，点「发一句」试试。</view>
  <block wx:for="{{items}}" wx:key="id"><view wx:if="{{item.showDay}}" class="thought-day">{{item.day}}</view>
    <view class="thought-card" data-id="{{item.id}}" bindtap="detail"><view class="thought-sender"><image wx:if="{{item.senderAvatarUrl}}" src="{{item.senderAvatarUrl}}" mode="aspectFill"/><view wx:else class="thought-avatar">{{item.senderInitial}}</view><view class="sender-copy"><view>{{item.senderName}}</view><text>{{item.time}}</text></view><text class="receipt">{{item.responded?'已回应':item.status}}</text></view><view class="thought-content thought-readable" data-id="{{item.id}}">{{item.content}}</view>
    <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="thought-reply thought-readable" data-id="{{reply.id}}"><view>{{reply.senderName}}：{{reply.content}}</view><text>{{reply.time}} · {{reply.status}}</text></view></view>
  </block>
  <view wx:if="{{hasMore}}" class="more-records" bindtap="loadMore">查看更多</view>
  <view class="thought-reminders" bindtap="notifications"><text>微信提醒</text><text>接收设置 ›</text></view>
</view>
<view wx:if="{{selected}}" class="detail-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="noop"><view class="life-row"><view class="life-heading">留言详情</view><text class="close" bindtap="closeDetail">×</text></view><scroll-view scroll-y class="detail-scroll" bindscroll="queueRead"><view class="life-subtitle">{{selected.senderName}} · {{selected.createdAt}}</view><view class="detail-content thought-readable" data-id="{{selected.id}}">{{selected.content}}</view><view class="detail-meta">{{selected.status}}{{selected.readAt && selected.readAt!=='已查看'?' · '+selected.readAt:''}}</view><text wx:if="{{selected.mine}}" class="delete" data-id="{{selected.id}}" bindtap="remove">删除这条留言</text><view wx:for="{{selected.replies}}" wx:key="id" class="detail-reply"><view class="life-subtitle">{{item.senderName}} · {{item.createdAt}}</view><view class="detail-content thought-readable" data-id="{{item.id}}">{{item.content}}</view><view class="detail-meta">{{item.status}}</view><text wx:if="{{item.mine}}" class="delete" data-id="{{item.id}}" bindtap="remove">删除这条回复</text></view></scroll-view><button class="life-button" data-id="{{selected.id}}" bindtap="reply">回一句</button></view></view>
<thought-compose open="{{composing}}" root-id="{{replyRoot}}" replying="{{replyRoot>0}}" bind:close="closeCompose" bind:sent="sent"/>
