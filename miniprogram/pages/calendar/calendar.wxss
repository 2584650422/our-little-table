/* Give the calendar more breathing room and keep day records lightweight. */
.calendar-page {
  padding-top: 18rpx;
}
.calendar-page .life-title {
  font-size: 46rpx;
  margin: 8rpx 0 14rpx;
}
.calendar-page .life-eyebrow {
  font-size: 20rpx;
  line-height: 1.5;
}
.calendar-page .month-card {
  margin: 12rpx 0 16rpx;
}
.together-row .life-link {
  padding: 8rpx 0;
}
.calendar-page .calendar-event {
  margin: 8rpx 0;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  text-align: center;
  align-items: center;
}
.weekday {
  font-size: 22rpx;
  color: #798279;
  padding: 16rpx 0 12rpx;
}
.month-card {
  padding: 16rpx 22rpx 12rpx;
}
.month-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #283b34;
}
.month-arrow {
  padding: 4rpx 18rpx;
  line-height: 1;
  font-size: 38rpx;
  color: #42664f;
}
.day {
  height: 84rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 8rpx;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.day > text {
  position: relative;
  z-index: 1;
}
.day-number {
  font-size: 28rpx;
  line-height: 32rpx;
  color: #283b34;
}
.day-lunar {
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 22rpx;
  color: #879286;
  white-space: nowrap;
}
.lunar-month-start {
  color: #42664f;
}
.day.selected::before {
  content: '';
  position: absolute;
  top: 2rpx;
  width: 68rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #42664f;
}
.selected .day-number,
.selected .day-lunar {
  color: #fffef9;
}
.day-markers {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  height: 10rpx;
  display: flex;
  justify-content: center;
  gap: 6rpx;
}
.event-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex: none;
}
.legend-dot {
  display: inline-block;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  flex: none;
}
.calendar-page .important-dot {
  background: #b97461;
}
.calendar-page .diary-dot {
  background: #438c95;
}
.calendar-page .selected .diary-dot {
  background: #a9dfe0;
}
.calendar-page .selected .important-dot {
  background: #f0bbab;
}
.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  color: #798279;
  font-size: 22rpx;
  margin: 14rpx 0 4rpx;
}
.calendar-legend > text {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.together-row {
  font-size: 25rpx;
  color: #798279;
}
.calendar-entry-actions {
  display: flex;
  gap: 18rpx;
  margin: 0 0 12rpx;
}
.calendar-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 16rpx 14rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}
.calendar-entry::after {
  border: 0;
}
.entry-copy {
  flex: 1;
  min-width: 0;
}
.calendar-entry text {
  display: block;
  font-size: 19rpx;
  font-weight: 400;
  margin-top: 4rpx;
}
.diary-entry {
  background: #ddedea;
  color: #357d85;
}
.important-entry {
  background: #f2e7df;
  color: #975f4c;
}
.entry-icon {
  flex: none;
  width: 44rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-pencil {
  position: relative;
  width: 10rpx;
  height: 32rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx 3rpx 0 0;
  transform: rotate(40deg);
  box-sizing: border-box;
}
.entry-pencil::after {
  content: '';
  position: absolute;
  left: -2rpx;
  bottom: -9rpx;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 7rpx solid currentColor;
}
.entry-calendar {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}
.entry-calendar::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 0;
  right: 0;
  border-top: 2rpx solid currentColor;
}
.entry-calendar::after {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  height: 7rpx;
  top: -5rpx;
  border-left: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
}
.entry-calendar-dots {
  width: 3rpx;
  height: 3rpx;
  background: currentColor;
  position: absolute;
  top: 14rpx;
  left: 6rpx;
  box-shadow:
    9rpx 0 currentColor,
    0 7rpx currentColor,
    9rpx 7rpx currentColor;
}
.day-records {
  margin: 14rpx 0 18rpx;
}
.selected-date-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 6rpx;
}
.selected-date-copy {
  flex: 1;
  min-width: 0;
}
.selected-date-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #283b34;
  line-height: 1.6;
}
.selected-lunar {
  font-size: 23rpx;
  color: #879286;
  line-height: 1.6;
  margin-top: 3rpx;
}
.selected-date-heading .life-link {
  flex: none;
  white-space: nowrap;
  padding-top: 10rpx;
}
.calendar-event {
  display: block;
  width: 100%;
  height: auto;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.calendar-event .life-event-copy {
  width: 100%;
  min-width: 0;
}
.calendar-page .diary-card {
  background: #edf5f4;
  border-left: 6rpx solid #bad6ce;
}
.calendar-page .important-card {
  background: #fffef9;
}
.record-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}
.record-title {
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.45;
  word-break: break-word;
  white-space: pre-wrap;
  flex: 1;
  min-width: 0;
}
.record-kind {
  flex: none;
  font-size: 18rpx;
  padding: 3rpx 8rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  line-height: 1.5;
}
.diary-kind {
  background: #d6eae8;
  color: #357d85;
}
.important-kind {
  background: #f4e6e0;
  color: #a65f4c;
}
.diary-content {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
  font-size: 26rpx;
  line-height: 1.55;
  color: #56655d;
  margin-top: 6rpx;
}
.record-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #68776f;
  line-height: 1.6;
}
.author-time {
  color: #879286;
}
.author-avatar {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.author-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dce7d8;
  color: #42664f;
  font-size: 18rpx;
}

/* Keep the calendar easy to scan; let the secondary upcoming list stay tucked away. */
.calendar-page .month-card {
  padding: 20rpx 24rpx 16rpx;
}
.calendar-page .weekday {
  padding-top: 20rpx;
  padding-bottom: 16rpx;
}
.calendar-page .day {
  height: 94rpx;
  padding-top: 10rpx;
}
.calendar-page .day.selected::before {
  height: 88rpx;
}
.calendar-page .calendar-legend {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
}
.calendar-page .calendar-event {
  padding: 10rpx 16rpx;
}
.calendar-page .diary-content {
  margin-top: 4rpx;
}
.calendar-page .record-author {
  margin-top: 5rpx;
}
.upcoming-toggle {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 28rpx 4rpx 14rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #e4e7dc;
  color: #42664f;
}
.upcoming-toggle-title {
  font-size: 27rpx;
  font-weight: 600;
}
.upcoming-toggle-meta {
  flex: 1;
  color: #879286;
  font-size: 21rpx;
  text-align: right;
}
.upcoming-toggle-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e7ecdd;
  color: #42664f;
  font-size: 19rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}
.upcoming-toggle-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #879286;
  border-bottom: 3rpx solid #879286;
  transform: rotate(45deg) translateY(-3rpx);
  transition: transform 160ms ease;
}
.upcoming-toggle-chevron.expanded {
  transform: rotate(225deg) translateY(-1rpx);
}
.upcoming-content {
  padding-bottom: 8rpx;
}

.calendar-thoughts {
  margin: 30rpx 0;
  padding: 28rpx 4rpx;
  border-top: 1rpx solid #e4e7dc;
}
.calendar-thoughts > view {
  display: flex;
  justify-content: space-between;
  font-size: 27rpx;
  color: #42664f;
}
.calendar-thoughts > text {
  display: block;
  font-size: 23rpx;
  color: #879286;
  margin-top: 14rpx;
}
.thought-retry {
  font-size: 22rpx;
  color: #879286;
  padding: 20rpx 0;
}
.thought-day-mask {
  position: fixed;
  inset: 0;
  background: #26332a69;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.thought-day-sheet {
  background: #fffef9;
  border-radius: 44rpx 44rpx 0 0;
  padding: 8rpx 40rpx max(32rpx, env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}
.thought-day-sheet .life-heading {
  font-size: 30rpx;
}
.thought-day-close {
  font-size: 44rpx;
  color: #879286;
  padding: 10rpx;
}
.thought-day-scroll {
  max-height: 55vh;
  margin-top: 24rpx;
}
.thought-day-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e4e7dc;
}
.thought-day-sender {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
}
.thought-day-sender image,
.thought-day-sender > view:first-child {
  height: 68rpx;
  width: 68rpx;
  border-radius: 50%;
  flex: none;
}
.thought-day-sender > view:first-child {
  line-height: 68rpx;
  text-align: center;
  background: #e7ecdd;
  color: #42664f;
}
.thought-day-sender text {
  display: block;
  color: #879286;
  font-size: 21rpx;
  margin-top: 6rpx;
}
.thought-day-content {
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.7;
  font-size: 28rpx;
  margin: 24rpx 0 14rpx 88rpx;
}
.thought-day-status {
  display: block;
  font-size: 21rpx;
  color: #879286;
  margin-left: 88rpx;
}
.thought-day-link {
  text-align: center;
  color: #42664f;
  font-size: 26rpx;
  padding: 30rpx 0 12rpx;
}

.calendar-thought-reply {
  background: #f7f5ee;
  border-radius: 20rpx;
  padding: 22rpx;
  margin: 20rpx 0 0 88rpx;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.calendar-thought-reply text {
  display: block;
  font-size: 21rpx;
  color: #879286;
  margin-top: 6rpx;
}

.interaction-dot { background: #9886b5; }

.calendar-page .selected .interaction-dot { background: #d1c1e5; }
