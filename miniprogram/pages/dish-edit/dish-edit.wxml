<view class="page"><view class="photo" bindtap="imageAction"><image wx:if="{{form.imageUrl}}" src="{{form.imageUrl}}" mode="aspectFill"/><view wx:else class="image-placeholder">{{uploading?'上传中…':'＋ 添加菜品图片'}}</view></view><view class="field"><text class="label">菜名 *</text><input class="input" value="{{form.name}}" placeholder="比如：可乐鸡翅" data-key="name" bindinput="input"/></view><view class="field"><text class="label">分类 *</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="input">{{categories[categoryIndex].icon}} {{categories[categoryIndex].name}} ›</view></picker></view><view class="field"><text class="label">一句话描述</text><input class="input" value="{{form.description}}" placeholder="说说它为什么值得吃" data-key="description" bindinput="input"/></view><view class="two"><view class="field"><text class="label">估算热量 kcal</text><input class="input" type="number" value="{{form.calorieKcal}}" placeholder="可不填" data-key="calorieKcal" bindinput="input"/></view><view class="field"><text class="label">烹饪时间 分钟</text><input class="input" type="number" value="{{form.cookTimeMinutes}}" placeholder="可不填" data-key="cookTimeMinutes" bindinput="input"/></view></view><view class="field"><text class="label">份量说明</text><input class="input" value="{{form.servingNote}}" data-key="servingNote" bindinput="input"/></view><view class="field"><text class="label">难度</text><radio-group class="options" bindchange="difficulty"><label><radio value="easy" checked="{{form.difficulty==='easy'}}" color="#FF8FAE"/>轻松</label><label><radio value="medium" checked="{{form.difficulty==='medium'}}" color="#FF8FAE"/>一般</label><label><radio value="hard" checked="{{form.difficulty==='hard'}}" color="#FF8FAE"/>认真做</label></radio-group></view><view class="field"><text class="label">辣度 {{form.spicyLevel}} / 5</text><slider min="0" max="5" step="1" value="{{form.spicyLevel}}" activeColor="#FF8FAE" bindchange="spicy"/></view><view class="field"><text class="label">标签（用顿号隔开）</text><input class="input" value="{{form.tags}}" placeholder="下饭、鸡肉、微辣" data-key="tags" bindinput="input"/></view><view class="field"><text class="label">排序</text><input class="input" type="number" value="{{form.sortOrder}}" data-key="sortOrder" bindinput="input"/></view><button class="btn save" bindtap="save">保存到我们的菜单</button></view>
