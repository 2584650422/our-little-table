<view class="prototype-page edit-page">
  <subpage-header title="{{id?'编辑菜品':'新增菜品'}}"/>
  <view class="photo media-hero" bindtap="imageAction"><image wx:if="{{form.imageUrl}}" src="{{form.imageUrl}}" mode="aspectFill"/><view wx:else class="media-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/><text>{{uploading?'正在处理图片…':'＋ 添加菜品图片'}}</text></view><view wx:if="{{form.imageUrl}}" class="photo-action">▣ {{uploading?'正在上传…':'更换图片'}}</view></view>
  <view class="prototype-card field-card"><view class="field-row"><text class="field-name">菜名 *</text><input value="{{form.name}}" placeholder="比如：可乐鸡翅" data-key="name" bindinput="input"/></view></view>
  <view class="prototype-card field-card"><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="field-row"><text class="field-name">分类 *</text><text class="field-value">{{categories.length?categories[categoryIndex].name:'请选择分类'}} <text class="arrow">›</text></text></view></picker></view>
  <view class="prototype-card field-card"><view class="field-row"><text class="field-name">一句话描述</text><input value="{{form.description}}" placeholder="说说它为什么值得吃" data-key="description" bindinput="input"/></view></view>
  <view class="two"><view class="prototype-card mini-field"><text>估算热量</text><view><input type="number" value="{{form.calorieKcal}}" placeholder="可不填" data-key="calorieKcal" bindinput="input"/><text>kcal / 份</text></view></view><view class="prototype-card mini-field"><text>烹饪时间</text><view><input type="number" value="{{form.cookTimeMinutes}}" placeholder="可不填" data-key="cookTimeMinutes" bindinput="input"/><text>分钟</text></view></view></view>
  <view class="more-title">更多信息</view>
  <view class="prototype-card more-card"><view class="field-row"><text class="field-name">份量</text><input value="{{form.servingNote}}" placeholder="例如 两人份" data-key="servingNote" bindinput="input"/></view><view class="prototype-divider"/><view class="field-row"><text class="field-name">难度</text><picker range="{{difficultyOptions}}" range-key="name" value="{{difficultyIndex}}" bindchange="difficulty"><view class="field-value">{{difficultyOptions[difficultyIndex].name}} <text class="arrow">›</text></view></picker></view><view class="prototype-divider"/><view class="field-row"><text class="field-name">辣度</text><picker range="{{spicyOptions}}" value="{{form.spicyLevel}}" bindchange="spicy"><view class="field-value">{{spicyOptions[form.spicyLevel]}} <text class="arrow">›</text></view></picker></view><view class="prototype-divider"/><view class="field-row"><text class="field-name">标签</text><input value="{{form.tags}}" placeholder="下饭、家常味" data-key="tags" bindinput="input"/></view></view>
  <view class="image-hint">照片上传前会裁成 4:3，并压缩至 2MB 以内；较小的照片可能在大图中略有放大。</view>
  <view class="prototype-button prototype-fixed" bindtap="save">保存菜品</view>
</view>
