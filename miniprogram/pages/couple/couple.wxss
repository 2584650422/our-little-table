.welcome {
  text-align: center;
  padding: 52rpx 0 36rpx;
}
.emoji {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}
.switch {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin: 28rpx 0;
}
.switch view {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 999rpx;
}
.switch .active {
  background: #ffdce6;
  color: #a96379;
}
.code-input {
  text-transform: uppercase;
  letter-spacing: 8rpx;
  text-align: center;
}
.submit {
  width: 100%;
  margin-top: 40rpx;
}
.success {
  text-align: center;
  padding: 50rpx 30rpx;
}
.code {
  font-size: 50rpx;
  letter-spacing: 9rpx;
  color: #e86f94;
  font-weight: 700;
  margin: 40rpx 0;
}
.success .btn {
  width: 100%;
  margin-top: 18rpx;
}
.saved {
  padding: 12rpx 26rpx;
}
.saved-title {
  font-size: 29rpx;
  font-weight: 700;
  padding: 18rpx 0 12rpx;
}
.couple-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f4e4ea;
}
.couple-name {
  font-size: 27rpx;
  font-weight: 600;
}
.couple-row text {
  display: block;
  margin-top: 6rpx;
  color: #a89ca0;
  font-size: 21rpx;
}
.current-tag {
  display: inline-block !important;
  margin: 0 0 0 10rpx !important;
  padding: 3rpx 9rpx;
  border-radius: 999rpx;
  background: #fff0f4;
  color: #c45f7d !important;
  font-size: 18rpx !important;
}
.switch-btn {
  margin: 0;
  background: #fff0f4;
  color: #c45f7d;
  border-radius: 999rpx;
  font-size: 23rpx;
}
.switch-btn::after {
  border: 0;
}
