<view class="page"><view class="welcome"><view class="emoji">🍚</view><view class="title">两个人的小饭桌</view><view class="subtitle">每一张饭桌，都可以留下来慢慢记住。</view></view><view wx:if="{{loading}}" class="loading">正在摆好饭桌…</view><block wx:else><view wx:if="{{couples.length}}" class="card saved"><view class="saved-title">我加入过的小饭桌</view><view wx:for="{{couples}}" wx:key="id" class="couple-row"><view><view class="couple-name">{{item.name}}<text wx:if="{{item.isCurrent}}" class="current-tag">正在使用</text></view><text>{{item.memberCount}} / 2 位成员</text></view><button wx:if="{{!item.isCurrent}}" class="switch-btn" bindtap="switchCouple" data-id="{{item.id}}">切换</button></view></view><view class="section-title">新建或加入</view><view wx:if="{{created}}" class="card success"><view class="title">小饭桌摆好啦</view><view class="muted">把邀请码悄悄发给另一位，有效期 7 天</view><view class="code" bindtap="copy">{{created.inviteCode}}</view><button class="btn secondary" bindtap="copy">复制邀请码</button><button class="btn" bindtap="home">先去看看菜单</button></view><block wx:else><view class="field"><text class="label">你希望我怎么叫你？</text><input class="input" placeholder="你的昵称" value="{{nickname}}" data-key="nickname" bindinput="input"/></view><view class="switch"><view class="{{mode==='create'?'active':''}}" data-mode="create" bindtap="mode">创建饭桌</view><view class="{{mode==='join'?'active':''}}" data-mode="join" bindtap="mode">加入饭桌</view></view><view wx:if="{{mode==='create'}}" class="field"><text class="label">给小饭桌起个名字</text><input class="input" value="{{name}}" data-key="name" bindinput="input"/></view><view wx:else class="field"><text class="label">伴侣给你的邀请码</text><input class="input code-input" maxlength="8" placeholder="例如 FANFAN88" value="{{inviteCode}}" data-key="inviteCode" bindinput="input"/></view><button class="btn submit" bindtap="submit">{{mode==='create'?'创建新的小饭桌':'坐到一起'}}</button></block></block></view>
