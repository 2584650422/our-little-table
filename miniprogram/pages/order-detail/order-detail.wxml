<view class="prototype-page order-page">
  <subpage-header/>
  <view wx:if="{{loading}}" class="loading">正在看看这顿饭…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="order-head"><view class="head-row"><view class="prototype-title">这一顿</view><order-status status="{{order.status}}"/></view><view class="date-line">{{order.dateLabel}} · {{order.mealLabel}}</view><view class="creator-line">{{order.creatorName}} 点的<text wx:if="{{order.targetName}}"> · {{order.targetName}} 来上菜</text></view></view>
    <view class="prototype-card dishes-card"><view wx:for="{{order.items}}" wx:key="id" class="dish-item"><image wx:if="{{item.dishImageUrl}}" class="media-thumb" src="{{item.dishImageUrl}}" mode="aspectFill"/><view wx:else class="media-thumb media-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view><view class="dish-name">{{item.dishName}}</view><text class="quantity">{{item.quantity}} 份</text></view></view>
    <view wx:if="{{order.message}}" class="message-card"><view>给对方的话</view><text>{{order.message}}</text></view>
    <view wx:if="{{order.isRecorded}}" class="section-title">我们的饭饭记录</view>
    <view wx:if="{{order.isRecorded}}" class="photo-gallery"><block wx:for="{{order.reviews}}" wx:key="userId"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="record-photo"/></block><view class="add-photo" bindtap="addPhoto">＋ {{order.reviews.length?'补充成品照片':'添加成品照片'}}</view></view>
    <view wx:for="{{order.comments}}" wx:key="userId" class="comment-row"><view class="comment-top"><text class="comment-name">{{item.nickname}}</text><text class="comment-time">{{item.createdLabel}}</text><text wx:if="{{item.isMine}}" class="delete-comment" bindtap="deleteComment">删除</text></view><view class="comment-text">{{item.comment}}</view></view>
    <view wx:if="{{order.isRecorded}}" class="comment-editor"><textarea maxlength="300" placeholder="留一句感受…" value="{{comment}}" bindinput="comment"/><view class="comment-save" bindtap="saveComment">发表</view></view>
    <view wx:if="{{order.totalCalories}}" class="calorie">这一顿约 {{order.totalCalories}} kcal · 家庭做法估算</view>
    <view wx:if="{{order.status==='ready'||order.status==='completed'||order.status==='cancelled'}}" class="delete-order" bindtap="remove">删除这条记录</view>
    <view wx:if="{{order.isServable}}" class="cancel" bindtap="cancel">这次先不吃了</view>
    <view wx:if="{{order.isServable}}" class="prototype-button prototype-fixed" bindtap="serve">{{serving?'正在上菜…':'已上菜'}}</view>
    <view wx:if="{{order.isRecorded}}" class="prototype-button prototype-fixed" bindtap="reorder">再来一顿</view>
  </block>
</view>
