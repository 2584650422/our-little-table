<view class="page"><view wx:if="{{loading}}" class="loading">正在看看这顿饭…</view><view wx:elif="{{error}}" class="error">{{error}}</view><block wx:else><view class="card header"><order-status status="{{order.status}}"/><view class="title">{{order.dateLabel}} · {{order.mealLabel}}</view><view class="subtitle">{{order.creatorName}} 点的<text wx:if="{{order.targetName}}">，等 {{order.targetName}} 上菜</text></view></view><view class="section-title">今天的小菜单</view><view class="card item" wx:for="{{order.items}}" wx:key="id"><image wx:if="{{item.dishImageUrl}}" class="item-image" src="{{item.dishImageUrl}}" mode="aspectFill"/><view wx:else class="thumb image-placeholder">🍽️</view><view class="info"><view>{{item.dishName}} ×{{item.quantity}}</view><view wx:if="{{item.dishCalorieKcal}}" class="muted">约 {{item.dishCalorieKcal*item.quantity}} kcal</view></view></view><view wx:if="{{order.message}}" class="card message"><view class="label">给对方的话</view>“{{order.message}}”</view><view wx:if="{{order.isRecorded}}" class="section-title">我们的饭后记录</view><view wx:for="{{order.comments}}" wx:key="userId" class="card review"><view class="review-head"><view><text class="review-name">{{item.nickname}}</text><text class="review-time">{{item.createdLabel}}</text></view><text wx:if="{{item.isMine}}" class="delete-comment" bindtap="deleteComment">删除</text></view><view class="review-comment">{{item.comment}}</view></view><view wx:if="{{order.isRecorded}}" class="card review-editor"><view class="label">留一句感受</view><textarea class="review-textarea" maxlength="300" placeholder="比如：今天这个特别好吃～" value="{{comment}}" bindinput="comment"/><button class="btn secondary" bindtap="saveComment">保存评论</button><button class="photo-button" bindtap="addPhoto">上传 / 补充成品照片</button></view><view wx:for="{{order.reviews}}" wx:key="userId" wx:if="{{item.imageUrl}}" class="card review-photo"><image class="review-image" src="{{item.imageUrl}}" mode="aspectFill"/></view><view wx:if="{{order.totalCalories}}" class="muted total">这一顿约 {{order.totalCalories}} kcal · 家庭估算</view><button wx:if="{{order.isServable}}" class="btn" loading="{{serving}}" bindtap="serve">{{serving?'正在上菜…':'已上菜'}}</button><button wx:if="{{order.isRecorded}}" class="btn secondary" bindtap="reorder">再来一顿</button><button wx:if="{{order.status==='ready'||order.status==='completed'||order.status==='cancelled'}}" class="delete-order" bindtap="remove">删除这条记录</button><button wx:if="{{order.isServable}}" class="cancel" bindtap="cancel">这次先不吃了</button></block></view>
