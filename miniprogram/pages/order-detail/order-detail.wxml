<view class="page"><view wx:if="{{loading}}" class="loading">正在看看这顿饭…</view><view wx:elif="{{error}}" class="error">{{error}}</view><block wx:else><view class="card header"><order-status status="{{order.status}}"/><view class="title">{{order.dateLabel}} · {{order.mealLabel}}</view><view class="subtitle">{{order.creatorName}} 点的<text wx:if="{{order.targetName}}">，等 {{order.targetName}} 一起开饭</text></view></view><view class="section-title">今天的小菜单</view><view class="card item" wx:for="{{order.items}}" wx:key="id"><image wx:if="{{item.dishImageUrl}}" src="{{item.dishImageUrl}}" mode="aspectFill"/><view wx:else class="thumb image-placeholder">🍽️</view><view class="info"><view>{{item.dishName}} ×{{item.quantity}}</view><view wx:if="{{item.dishCalorieKcal}}" class="muted">约 {{item.dishCalorieKcal*item.quantity}} kcal</view></view></view><view wx:if="{{order.message}}" class="card message"><view class="label">给对方的话</view>“{{order.message}}”</view><image wx:if="{{order.servedImageUrl}}" class="served-image" src="{{order.servedImageUrl}}" mode="aspectFill"/><view wx:if="{{order.totalCalories}}" class="muted total">这一顿约 {{order.totalCalories}} kcal · 家庭估算</view><button wx:if="{{order.isServable}}" class="btn" loading="{{serving}}" bindtap="serve">{{serving?'正在上菜…':'上菜啦'}}</button><button wx:if="{{order.status==='ready'}}" class="btn" bindtap="finish">吃完啦</button><button wx:if="{{order.status==='completed'}}" class="btn secondary" bindtap="reorder">再来一顿</button><button wx:if="{{order.status==='completed'||order.status==='cancelled'}}" class="delete-order" bindtap="remove">删除这条记录</button><button wx:if="{{order.status!=='completed'&&order.status!=='cancelled'}}" class="cancel" bindtap="cancel">这次先不吃了</button></block></view>
