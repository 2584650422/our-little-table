.header{text-align:center;padding:44rpx 28rpx}.header .title{margin-top:24rpx}.item{display:flex;align-items:center}.item-image,.thumb{width:112rpx;height:112rpx;border-radius:20rpx}.info{margin-left:20rpx;line-height:1.8}.message{line-height:1.7}.total{text-align:center;margin:24rpx}.btn{width:100%;margin-top:18rpx}.review-textarea{display:block;width:100%;min-height:130rpx;box-sizing:border-box;padding:18rpx;margin-top:14rpx;background:#FFF8FA;border-radius:18rpx;font-size:25rpx;line-height:1.6}.photo-button{display:block;width:100%;margin-top:16rpx;background:#FFF8FA;color:#A96379;border-radius:999rpx;font-size:25rpx}.photo-button::after{border:0}.review{padding:24rpx 28rpx}.review-head{display:flex;align-items:center;justify-content:space-between}.review-name{font-size:26rpx;font-weight:600;color:#694D55}.review-time{margin-left:14rpx;color:#B8ADB1;font-size:20rpx}.delete-comment{color:#C45F7D;font-size:22rpx}.review-comment{margin-top:12rpx;color:#62575B;font-size:26rpx;line-height:1.65;white-space:pre-wrap}.review-photo{padding:0}.review-image{display:block;width:100%;height:330rpx;border-radius:20rpx}.cancel,.delete-order{background:transparent;color:#B8ADB1;font-size:24rpx;margin-top:14rpx}.delete-order{display:block;margin:22rpx auto 0;color:#C45F7D}.cancel::after,.delete-order::after{border:0}
