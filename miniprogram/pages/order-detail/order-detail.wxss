.header{text-align:center;padding:44rpx 28rpx}.header .title{margin-top:24rpx}.item{display:flex;align-items:center}.item image,.thumb{width:112rpx;height:112rpx;border-radius:20rpx}.info{margin-left:20rpx;line-height:1.8}.message{line-height:1.7}.served-image{width:100%;height:360rpx;border-radius:28rpx;margin:0 0 24rpx}.total{text-align:center;margin:24rpx}.btn{width:100%;margin-top:18rpx}.cancel,.delete-order{background:transparent;color:#B8ADB1;font-size:24rpx;margin-top:14rpx}.delete-order{display:block;margin:22rpx auto 0;color:#C45F7D}.cancel::after,.delete-order::after{border:0}
