.order-page {
  padding-bottom: 180rpx;
}
.order-head {
  margin: 0 4rpx 20rpx;
}
.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-line {
  font-size: 26rpx;
  color: #55525a;
  margin-top: 9rpx;
}
.creator-line {
  font-size: 21rpx;
  color: #96929b;
  margin-top: 5rpx;
}
.dishes-card {
  padding: 3rpx 14rpx;
  margin-bottom: 16rpx;
}
.dish-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  border-bottom: 1rpx solid #f0edee;
}
.dish-item:last-child {
  border: 0;
}
.dish-item .media-thumb {
  width: 92rpx;
  height: 92rpx;
}
.dish-name {
  font-size: 27rpx;
  font-weight: 650;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quantity {
  font-size: 23rpx;
  color: #74717c;
  padding-right: 12rpx;
}
.message-card {
  background: #fcf5f4;
  border-radius: 23rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.message-card view {
  font-size: 25rpx;
  color: #333038;
  margin-bottom: 10rpx;
}
.message-card text {
  font-size: 23rpx;
  color: #6c6671;
  line-height: 1.6;
}
.section-title {
  font-size: 29rpx;
  margin: 15rpx 4rpx 13rpx;
}
.photo-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 0 4rpx 15rpx;
}
.record-photo,
.add-photo {
  width: 220rpx;
  height: 165rpx;
  border-radius: 18rpx;
  background: #f4f1ee;
}
.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #a76f75;
  font-size: 21rpx;
  border: 1rpx dashed #e8c7ca;
}
.comment-row {
  padding: 13rpx 3rpx;
}
.comment-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.comment-name {
  font-size: 23rpx;
  font-weight: 650;
}
.comment-time {
  font-size: 19rpx;
  color: #96929b;
}
.delete-comment {
  margin-left: auto;
  font-size: 19rpx;
  color: #d57b82;
}
.comment-text {
  font-size: 23rpx;
  color: #5e5b65;
  line-height: 1.5;
  margin-top: 5rpx;
  white-space: pre-wrap;
}
.comment-editor {
  background: #f4f3f3;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.comment-input {
  display: block;
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #5e5b65;
}
.comment-placeholder {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #96929b;
}
.comment-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.comment-save {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #fbecee;
  font-size: 24rpx;
  color: #c66e78;
  padding: 0 22rpx;
}
.calorie {
  font-size: 20rpx;
  color: #a09ba0;
  text-align: center;
  margin: 18rpx;
}
.delete-order,
.cancel {
  text-align: center;
  color: #b7767d;
  font-size: 22rpx;
  padding: 12rpx;
  margin-top: 14rpx;
}
.cancel {
  color: #9c989b;
}
.dish-item {
  min-height: 143rpx;
}
.dish-item .media-thumb {
  width: 118rpx;
  height: 118rpx;
}
