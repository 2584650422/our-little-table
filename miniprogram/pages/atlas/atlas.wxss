.atlas-page {
  padding-left: 44rpx;
  padding-right: 44rpx;
}
.atlas-page .life-title {
  margin-bottom: 8rpx;
}
.atlas-add {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx;
  border-radius: 22rpx;
  background: #42664f;
  color: #fffef9;
  font-size: 25rpx;
  line-height: 1.6;
}
.atlas-tabs {
  display: flex;
  gap: 10rpx;
  margin: 28rpx 0 22rpx;
}
.atlas-tabs text {
  padding: 13rpx 28rpx;
  background: #fffef9;
  border-radius: 18rpx;
  font-size: 25rpx;
}
.atlas-tabs .active {
  background: #42664f;
  color: #fffef9;
}
.atlas-region-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 56rpx;
  margin: 0 0 14rpx;
  padding: 0 4rpx;
  color: #42664f;
  font-size: 24rpx;
  font-weight: 600;
}
.region-hint {
  color: #879286;
  font-size: 21rpx;
  font-weight: 400;
}
.region-reset {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6eee2;
  color: #42664f;
  font-size: 21rpx;
  font-weight: 500;
}
.atlas-map-shell {
  position: relative;
  height: 440rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.atlas-fullscreen {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 254, 249, 0.92);
  color: #42664f;
  font-size: 26rpx;
}
.atlas-fullscreen text {
  font-size: 20rpx;
}
.atlas-map-hint {
  margin: 12rpx 4rpx 4rpx;
  color: #879286;
  font-size: 20rpx;
  text-align: right;
}
.atlas-region-empty {
  margin: 24rpx 0 8rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #fffef9;
  color: #798279;
  font-size: 24rpx;
  text-align: center;
}
.atlas-story {
  margin-top: 28rpx;
}
.atlas-story .life-heading {
  margin: 0 0 18rpx;
  font-size: 32rpx;
}
.atlas-story .life-photo {
  border-radius: 22rpx;
}
.atlas-story .caption {
  margin: 18rpx 0 6rpx;
}
.atlas-empty {
  margin: 28rpx 0 8rpx;
  color: #283b34;
  font-size: 29rpx;
}
.atlas-empty text {
  display: block;
  margin-top: 7rpx;
  color: #798279;
  font-size: 24rpx;
}
.atlas-retry {
  margin: 20rpx 0;
  color: #b97461;
  font-size: 23rpx;
}
.atlas-source {
  margin: 28rpx 0 6rpx;
  color: #798279;
  font-size: 20rpx;
}
.photo-columns {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}
.photo-column {
  flex: 1;
  min-width: 0;
}
.photo-item {
  background: #fffef9;
  padding: 12rpx;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
}
.caption {
  margin: 16rpx 0;
  font-size: 26rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.photo-item .life-photo {
  border-radius: 16rpx;
}

.atlas-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 22rpx 0 16rpx;
  color: #42664f;
  font-size: 24rpx;
}
.atlas-toolbar-label {
  flex: 1;
  min-width: 0;
}
.atlas-toolbar-actions,
.photo-actions {
  display: flex;
  flex: none;
  gap: 20rpx;
  align-items: center;
}
.atlas-tool {
  padding: 10rpx 18rpx;
  background: #e7ecdd;
  border-radius: 30rpx;
  white-space: nowrap;
}

.story-heading {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 18rpx;
}
.story-place {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #283b34;
}
.story-date {
  flex: none;
  font-size: 23rpx;
  line-height: 45rpx;
  color: #879286;
}
.story-swiper {
  width: 100%;
  border-radius: 22rpx;
  overflow: hidden;
  background: #e7ecdd;
}
.story-image {
  display: block;
  width: 100%;
  height: 100%;
}
.story-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #879286;
  font-size: 21rpx;
  min-height: 58rpx;
}
.photo-menu {
  padding: 4rpx 12rpx;
  font-size: 32rpx;
  line-height: 40rpx;
  color: #647b66;
  letter-spacing: 3rpx;
}
.story-caption {
  font-size: 27rpx;
  line-height: 1.75;
  color: #405247;
  white-space: pre-wrap;
  word-break: break-word;
  margin: 2rpx 0 22rpx;
}
.wall-intro {
  margin: 6rpx 0 26rpx;
  font-size: 23rpx;
  color: #879286;
  line-height: 1.6;
}
.photo-item {
  padding: 0;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx #283b3408;
}
.photo-item .life-photo {
  display: block;
  width: 100%;
  border-radius: 0;
}
.wall-copy {
  padding: 18rpx 18rpx 8rpx;
}
.wall-place {
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.55;
  color: #405247;
  word-break: break-word;
}
.wall-caption {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #798279;
  white-space: pre-wrap;
  word-break: break-word;
}
.wall-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #98a092;
}
