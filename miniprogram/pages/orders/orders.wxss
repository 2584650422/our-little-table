page{background:#fff}.history-page{background:#fff;padding-left:29rpx;padding-right:29rpx;padding-bottom:155rpx}.history-header{height:125rpx;display:flex;align-items:center;justify-content:space-between}.page-title{font-size:52rpx;line-height:1.2;font-weight:750;color:#202024}.search-toggle{height:56rpx;width:56rpx;display:flex;justify-content:center;align-items:center}.glass{width:24rpx;height:24rpx;border:3rpx solid #525358;border-radius:50%;position:relative}.glass::after{content:'';position:absolute;width:13rpx;height:3rpx;background:#525358;right:-11rpx;bottom:-5rpx;transform:rotate(46deg);border-radius:3rpx}.search-bar{height:73rpx;display:flex;align-items:center;padding:0 19rpx;border-radius:17rpx;background:#F6F4F3;margin-bottom:20rpx}.search-bar input{flex:1;font-size:25rpx}.search-bar text{color:#CE7278;font-size:23rpx}.active-link{display:flex;justify-content:space-between;align-items:center;margin:2rpx 0 28rpx;padding:20rpx 24rpx;background:#FDF2F0;color:#B9676D;border-radius:19rpx;font-size:23rpx}.back-link{padding:0 0 25rpx;color:#B76D72;font-size:24rpx}.record-block{margin:0 0 33rpx}.record-date{height:50rpx;display:flex;align-items:center;justify-content:space-between;color:#777476;font-size:26rpx;font-weight:550}.record-more{font-size:32rpx;color:#79777A;line-height:1;width:54rpx;text-align:center;letter-spacing:1rpx}.record-card{min-height:225rpx;background:#fff;display:flex;align-items:stretch;padding:8rpx;box-sizing:border-box;border-radius:29rpx;box-shadow:0 5rpx 27rpx rgba(45,37,36,.07);border:1rpx solid #F7F5F3}.record-image{width:209rpx;height:209rpx;flex-shrink:0;border-radius:23rpx;background:#F1ECE8}.record-placeholder{display:flex;align-items:center;justify-content:center;font-size:58rpx;color:#BBB1AB}.record-content{min-width:0;flex:1;padding:16rpx 13rpx 9rpx 19rpx;display:flex;flex-direction:column}.record-top{display:flex;align-items:center;gap:13rpx;font-size:23rpx;font-weight:620;color:#444247;white-space:nowrap}.status-chip{font-size:20rpx;font-weight:550;padding:6rpx 14rpx;border-radius:999rpx}.status-chip.done{background:#E9F4EA;color:#648C72}.status-chip.waiting{background:#FFF2E4;color:#B68B5E}.record-names{font-size:26rpx;font-weight:670;line-height:1.45;color:#28272B;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.record-note{font-size:21rpx;color:#9B9697;line-height:1.4;margin-top:auto;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.error .btn{margin-top:24rpx}

