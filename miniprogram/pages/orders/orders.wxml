<view class="page"><view class="tabs"><view class="{{tab==='active'?'active':''}}" data-tab="active" bindtap="choose">正在准备</view><view class="{{tab==='history'?'active':''}}" data-tab="history" bindtap="choose">我们吃过</view></view><view wx:if="{{loading}}" class="loading">正在翻饭饭记录…</view><view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view><block wx:else><view class="card order" wx:for="{{orders}}" wx:key="id" bindtap="detail" data-id="{{item.id}}"><view class="between"><view class="date">{{item.dateLabel}} · {{item.mealLabel}}</view><order-status status="{{item.status}}"/></view><view class="names"><text wx:for="{{item.items}}" wx:key="id">{{index?' · ':''}}{{item.dishName}} ×{{item.quantity}}</text></view><view class="muted">{{item.creatorName}} 点的<text wx:if="{{item.message}}"> · “{{item.message}}”</text></view><button wx:if="{{tab==='history'&&item.status==='completed'}}" class="again" catchtap="reorder" data-id="{{item.id}}">再吃一次</button></view><empty-state wx:if="{{!orders.length}}" icon="🍚" title="{{tab==='active'?'现在没有等着准备的饭':'还没有一起吃过的记录'}}" hint="{{tab==='active'?'正适合去菜单选点喜欢的':'第一顿饭会从这里开始'}}"/></block></view>
