<view class="page history-page" style="padding-top:{{topInset}}px">
  <view class="history-header"><view class="page-title">{{tab==='history'?'吃过':'等上菜'}}</view><view class="search-toggle" bindtap="toggleSearch"><view class="glass"></view></view></view>
  <view wx:if="{{searchOpen}}" class="search-bar"><input focus="{{searchOpen}}" placeholder="搜索吃过的菜或留言" value="{{keyword}}" bindinput="input"/><text catchtap="clearSearch">清空</text></view>
  <view wx:if="{{tab==='history'&&activeCount}}" class="active-link" bindtap="choose" data-tab="active"><text>有 {{activeCount}} 份小菜单正在等上菜</text><text>去看看 ›</text></view>
  <view wx:if="{{tab==='active'}}" class="back-link" bindtap="choose" data-tab="history">‹ 返回吃过的记录</view>
  <view wx:if="{{loading}}" class="loading">正在翻饭饭记录…</view>
  <view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
  <block wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="record-block">
      <view class="record-date"><text>{{item.dateLabel}}</text><text wx:if="{{tab==='history'}}" class="record-more" catchtap="showActions" data-id="{{item.id}}">···</text></view>
      <view class="record-card" bindtap="detail" data-id="{{item.id}}">
        <image wx:if="{{item.displayImage}}" class="record-image" src="{{item.displayImage}}" mode="aspectFill" lazy-load/><view wx:else class="record-image record-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view>
        <view class="record-content"><view class="record-top"><text>{{item.mealLabel}}</text><text class="status-chip {{item.status==='ready'||item.status==='completed'?'done':'waiting'}}">{{item.status==='ready'||item.status==='completed'?'已上菜':item.status==='cancelled'?'已取消':'等上菜'}}</text></view><view class="record-names"><text wx:for="{{item.items}}" wx:key="id">{{index?' · ':''}}{{item.dishName}}</text></view><view class="record-note">{{item.reviewText||item.message||item.creatorName+' 点的'}}</view></view>
      </view>
    </view>
    <empty-state wx:if="{{!orders.length}}" icon="🍚" title="{{tab==='active'?'现在没有等待上菜的点单':'还没有一起吃过的记录'}}" hint="{{tab==='active'?'正适合去菜单选点喜欢的':'第一顿饭会从这里开始'}}"/>
  </block>
</view>
