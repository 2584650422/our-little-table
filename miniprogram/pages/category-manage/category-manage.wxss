.intro{font-size:24rpx;color:#8A7E82;line-height:1.6;margin:0 6rpx 24rpx}.category-row{display:flex;align-items:center;padding:24rpx}.icon{font-size:34rpx;width:62rpx}.name{font-weight:600;flex:1}.order{font-size:22rpx;color:#B8ADB1}.delete{font-size:22rpx;color:#C47A8F;padding:16rpx}.arrow{font-size:34rpx;color:#B8ADB1}.add-btn{margin-top:26rpx}.mask{position:fixed;inset:0;background:rgba(42,34,37,.35);z-index:8}.editor{position:fixed;left:0;right:0;bottom:0;z-index:9;background:#fff;border-radius:34rpx 34rpx 0 0;padding:34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom))}.editor-title{font-size:34rpx;font-weight:700;margin-bottom:28rpx}.field{display:flex;align-items:center;border-bottom:1rpx solid #F4E4EA;padding:20rpx 0}.field text{width:160rpx;color:#62575B;font-size:25rpx}.field input{flex:1;background:#FFF7FA;border-radius:16rpx;padding:18rpx}.actions{display:flex;gap:18rpx;margin-top:30rpx}.actions button{flex:1;border-radius:999rpx}.actions .primary{background:#FF8FAE;color:#fff}.actions .secondary{background:#F6EEF1;color:#8A7E82}.actions button::after{border:0}
