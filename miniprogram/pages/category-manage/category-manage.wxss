.intro{font-size:24rpx;color:#8A7E82;line-height:1.6;margin:0 6rpx 24rpx}.category-row{display:flex;align-items:center;padding:24rpx;transition:transform .24s cubic-bezier(.2,.8,.2,1),box-shadow .24s ease,background .24s ease}.category-row.dragging{background:#FFF8FA;transform:scale(1.018);box-shadow:0 12rpx 28rpx rgba(232,111,148,.18);z-index:2}.category-row.shifting{animation:row-shift .22s cubic-bezier(.2,.8,.2,1)}.drag-handle{width:58rpx;height:58rpx;margin:-12rpx 8rpx -12rpx -12rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:#A99CA0;font-size:34rpx;letter-spacing:-8rpx;transform:rotate(90deg);background:#F8F3F5}.drag-handle:active{background:#FFE7EE;color:#C45F7D}.icon{font-size:34rpx;width:62rpx}.name{font-weight:600;flex:1}.delete{font-size:22rpx;color:#C47A8F;padding:16rpx}.arrow{font-size:34rpx;color:#B8ADB1}.add-btn{margin-top:26rpx}.mask{position:fixed;inset:0;background:rgba(42,34,37,.35);z-index:8}.editor{position:fixed;left:0;right:0;bottom:0;z-index:9;background:#fff;border-radius:34rpx 34rpx 0 0;padding:34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom))}.editor-title{font-size:34rpx;font-weight:700;margin-bottom:28rpx}.field{display:flex;align-items:center;border-bottom:1rpx solid #F4E4EA;padding:20rpx 0}.field text{width:160rpx;color:#62575B;font-size:25rpx}.field input{flex:1;background:#FFF7FA;border-radius:16rpx;padding:18rpx}.actions{display:flex;gap:18rpx;margin-top:30rpx}.actions button{flex:1;border-radius:999rpx}.actions .primary{background:#FF8FAE;color:#fff}.actions .secondary{background:#F6EEF1;color:#8A7E82}.actions button::after{border:0}@keyframes row-shift{from{transform:translateY(10rpx);opacity:.72}to{transform:translateY(0);opacity:1}}
