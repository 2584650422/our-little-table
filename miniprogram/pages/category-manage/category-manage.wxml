<view class="prototype-page category-page">
  <subpage-header/>
  <view class="prototype-title page-title">分类管理</view>
  <view class="prototype-caption intro">按住右侧手柄可调整菜单顺序</view>
  <view wx:if="{{loading}}" class="loading">正在整理分类…</view>
  <view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
  <block wx:else>
    <view wx:for="{{categories}}" wx:key="id" class="prototype-card category-row {{draggingId==item.id?'dragging':''}} {{shiftingId==item.id?'shifting':''}}">
      <view class="category-copy" bindtap="edit" data-id="{{item.id}}"><view class="category-name">{{item.name}}</view><view class="category-count">{{item.dishCount||0}} 个菜品</view></view>
      <view class="edit" bindtap="edit" data-id="{{item.id}}">编辑 <text>›</text></view>
      <view class="delete" bindtap="remove" data-id="{{item.id}}">删除</view>
      <view class="drag-handle" catchtap="noop" catchlongpress="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" data-id="{{item.id}}" aria-label="拖动排序"><view class="dots"><view/><view/><view/><view/><view/><view/></view></view>
    </view>
    <view wx:if="{{!categories.length}}" class="empty">还没有分类，先建一个吧</view>
  </block>
  <view class="prototype-button prototype-fixed" bindtap="add">＋ 新建分类</view>
  <view wx:if="{{editingId!==null}}" class="mask" bindtap="cancel"></view>
  <view wx:if="{{editingId!==null}}" class="editor" catchtap="noop">
    <view class="sheet-handle"></view><text class="sheet-close" bindtap="cancel">×</text>
    <view class="editor-title">{{editingId?'编辑分类':'新建分类'}}</view>
    <view class="editor-label">分类名称</view><input class="editor-input" value="{{form.name}}" maxlength="30" data-key="name" bindinput="input" placeholder="例如 家常菜" focus="{{true}}"/>
    <view class="editor-hint">菜单左侧会同步更新</view>
    <view class="actions"><view class="cancel-button" bindtap="cancel">取消</view><view class="prototype-button save-button" bindtap="save">保存</view></view>
  </view>
</view>
