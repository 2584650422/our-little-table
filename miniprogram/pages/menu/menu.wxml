<view class="menu-page" style="padding-top:{{topInset}}px">
  <view class="toolbar"><view class="menu-title">菜单</view><view class="menu-caption">一起做饭，一起吃饭</view><view class="search-toggle" catchtap="toggleSearch"><view class="glass"></view></view></view>
  <view wx:if="{{searchOpen}}" class="search-bar"><input focus="{{searchOpen}}" placeholder="搜索菜名、分类或标签" value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="search"/><text catchtap="clearSearch">清空</text></view>
  <view class="menu-body" bindtap="foldOnBackground">
    <scroll-view scroll-y class="category-rail">
      <view class="category {{categoryId===''?'active':''}}" bindtap="chooseCategory" data-id="">全部</view>
      <view wx:for="{{categories}}" wx:key="id" class="category {{categoryId==item.id?'active':''}}" bindtap="chooseCategory" data-id="{{item.id}}"><text class="category-name">{{item.name}}</text><text wx:if="{{item.cartCount}}" class="category-count">{{item.cartCount}}</text></view>
    </scroll-view>
    <scroll-view scroll-y class="dish-list">
      <view wx:if="{{loading}}" class="loading">正在端上菜单…</view>
      <view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
      <block wx:else>
        <view wx:for="{{dishes}}" wx:key="id" class="dish-row" bindtap="detail" data-id="{{item.id}}">
          <image wx:if="{{item.imageUrl}}" class="dish-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load/><view wx:else class="dish-image image-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view>
          <view class="dish-info"><view class="dish-name">{{item.name}}</view><view class="dish-description">{{item.description||'家常味道，想吃就点它'}}</view><view class="dish-meta">{{item.orderedCount?'点过 '+item.orderedCount+' 次':'还没点过'}}</view></view>
          <view class="add" catchtap="add" data-id="{{item.id}}">＋</view>
        </view>
        <empty-state wx:if="{{!dishes.length}}" icon="🍽️" title="这里还没有菜哦" hint="可以去菜单管理添一道喜欢的"/>
      </block>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
  <view class="selected-bar"><view class="selected-main" bindtap="toggleSelected"><text class="selected-text">已选 {{cartCount}} 个菜</text><view class="selected-thumbs"><block wx:for="{{selectedThumbs}}" wx:key="dishId"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="selected-thumb-fallback"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view></block></view></view><view class="selected-view" catchtap="goCart">查看</view></view>
  <view wx:if="{{selectedSheetMounted}}" class="sheet-mask {{selectedExpanded?'is-open':''}}" catchtap="closeSelected"></view>
  <view wx:if="{{selectedSheetMounted}}" class="selected-sheet {{selectedExpanded?'is-open':''}}" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head"><view><view class="sheet-title">今天的小菜单</view><view class="sheet-subtitle">选好了，再一起决定什么时候吃</view></view><view class="sheet-actions"><text class="clear" catchtap="clearSelected">清空</text><view class="sheet-close" catchtap="closeSelected">×</view></view></view>
    <scroll-view scroll-y class="sheet-list" style="height:{{sheetListHeight}}rpx"><view wx:for="{{selectedItems}}" wx:key="dishId" class="sheet-item"><image wx:if="{{item.imageUrl}}" class="sheet-image" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="sheet-image sheet-image-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view><view class="sheet-dish-copy"><view class="sheet-dish-name">{{item.dishName}}</view><view wx:if="{{item.calorieKcal}}" class="sheet-calorie">约 {{item.calorieKcal}} kcal / {{item.calorieUnit||'份'}}</view></view><view class="sheet-counter"><text class="counter-button" catchtap="changeQuantity" data-id="{{item.dishId}}" data-delta="-1">−</text><text class="counter-value">{{item.quantity}}</text><text class="counter-button plus" catchtap="changeQuantity" data-id="{{item.dishId}}" data-delta="1">＋</text></view><text class="remove-selected" catchtap="removeSelected" data-id="{{item.dishId}}">×</text></view></scroll-view>
    <view class="sheet-footer"><text>共选了 {{cartCount}} 份喜欢的</text><view class="sheet-submit" catchtap="goCart">就吃这些啦 <text>›</text></view></view>
  </view>
</view>
