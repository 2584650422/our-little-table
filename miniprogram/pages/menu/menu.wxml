<view class="menu-page">
  <view class="toolbar"><view class="search"><text>⌕</text><input placeholder="搜索菜名" value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="search"/><text class="search-action" bindtap="search">搜索</text></view></view>
  <view class="menu-body">
    <view class="rail-wrap">
      <scroll-view scroll-y class="category-rail">
        <view class="category {{categoryId===''?'active':''}}" bindtap="chooseCategory" data-id=""><text class="category-icon">🍽️</text><text class="category-name">全部</text></view>
        <view wx:for="{{categories}}" wx:key="id" class="category {{categoryId==item.id?'active':''}}" bindtap="chooseCategory" data-id="{{item.id}}"><text class="category-icon">{{item.icon}}</text><text class="category-name">{{item.name}}</text><text wx:if="{{item.cartCount}}" class="category-count">{{item.cartCount}}</text></view>
      </scroll-view>
      <view class="selected-entry" bindtap="toggleSelected"><text class="category-icon">⌑</text><view class="selected-copy"><text>已选菜品</text><text>{{cartCount?cartCount+' 件 · 点击展开':'还没有选菜'}}</text></view><view wx:if="{{cartCount}}" class="selected-count">{{cartCount}}</view></view>
    </view>
    <scroll-view scroll-y class="dish-list">
      <view class="list-title">{{activeCategoryName}}</view>
      <view wx:if="{{loading}}" class="loading">正在端上菜单…</view>
      <view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
      <block wx:else>
        <view wx:for="{{dishes}}" wx:key="id" class="dish-row" bindtap="detail" data-id="{{item.id}}">
          <image wx:if="{{item.imageUrl}}" class="dish-image" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="dish-image image-placeholder">🍚</view>
          <view class="dish-info"><view class="dish-name">{{item.name}}</view><view class="dish-description">{{item.description||'家常味道，想吃就点它'}}</view><view class="dish-meta"><text>{{item.orderedCount?'点过 '+item.orderedCount+' 次':'还没点过'}}</text><text wx:if="{{item.calorieKcal}}"> · 约 {{item.calorieKcal}} kcal</text></view></view>
          <view class="favorite {{item.isFavorite?'on':''}}" catchtap="favorite" data-id="{{item.id}}">{{item.isFavorite?'♥':'♡'}}</view><view class="add" catchtap="add" data-id="{{item.id}}">＋</view>
        </view>
        <empty-state wx:if="{{!dishes.length}}" icon="🍽️" title="这里还没有菜哦" hint="去我们页面的菜单管理添一道喜欢的"/>
      </block>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
  <view wx:if="{{selectedExpanded}}" class="selected-sheet">
    <view class="sheet-head"><view><text class="sheet-title">已选菜品</text><text class="sheet-count">{{cartCount}} 件</text></view><text class="clear" bindtap="clearSelected">一键清空</text></view>
    <scroll-view scroll-y class="sheet-list"><view wx:for="{{selectedItems}}" wx:key="dishId" class="sheet-item"><text class="sheet-dish-name">{{item.dishName}}</text><view class="sheet-counter"><text class="counter-button" catchtap="changeQuantity" data-id="{{item.dishId}}" data-delta="-1">−</text><text class="counter-value">{{item.quantity}}</text><text class="counter-button plus" catchtap="changeQuantity" data-id="{{item.dishId}}" data-delta="1">＋</text><text class="remove-selected" catchtap="removeSelected" data-id="{{item.dishId}}">删除</text></view></view><empty-state wx:if="{{!selectedItems.length}}" icon="🥣" title="还没有选菜" hint="从菜单里挑几样喜欢的吧"/></scroll-view>
    <button class="btn sheet-submit" bindtap="goCart">去提交</button>
  </view>
</view>
