page{height:100%;overflow:hidden;background:#fff}.menu-page{height:100vh;display:flex;flex-direction:column;background:#fff}.toolbar{height:112rpx;padding:16rpx 24rpx;box-sizing:border-box;display:flex;align-items:center;border-bottom:1rpx solid #F4E4EA;background:#fff}.search{height:76rpx;flex:1;display:flex;align-items:center;background:#F7F5F6;border-radius:20rpx;padding:0 22rpx;color:#8A7E82}.search input{flex:1;margin:0 12rpx;font-size:27rpx}.search-action,.manage{color:#E86F94;font-size:26rpx}.manage{padding:20rpx 0 20rpx 24rpx}.menu-body{flex:1;min-height:0;display:flex}.category-rail{width:196rpx;height:100%;background:#FAF8F9;flex-shrink:0}.category{min-height:100rpx;padding:18rpx 12rpx;box-sizing:border-box;display:flex;align-items:center;color:#655A5E;font-size:25rpx;position:relative}.category.active{background:#fff;color:#2F292B;font-weight:600}.category.active::before{content:'';position:absolute;left:0;width:7rpx;height:48rpx;border-radius:0 8rpx 8rpx 0;background:#FF8FAE}.category-icon{width:44rpx;text-align:center;font-size:27rpx;margin-right:2rpx;flex-shrink:0}.category-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.category-count{flex-shrink:0;min-width:30rpx;height:30rpx;padding:0 6rpx;margin-left:auto;box-sizing:border-box;border-radius:999rpx;background:#FFDCE6;color:#B25875;font-size:19rpx;line-height:30rpx;text-align:center}.category-manage{color:#8A7E82;border-top:1rpx solid #EEE6E9}.dish-list{height:100%;padding:0 24rpx;box-sizing:border-box;background:#fff}.list-title{font-size:30rpx;font-weight:700;padding:24rpx 0 18rpx}.dish-row{position:relative;display:flex;min-height:190rpx;padding:16rpx 0;border-bottom:1rpx solid #F5ECEF}.dish-image{width:170rpx;height:170rpx;border-radius:22rpx;flex-shrink:0}.dish-info{min-width:0;flex:1;padding:8rpx 56rpx 8rpx 18rpx}.dish-name{font-size:30rpx;font-weight:650;color:#30282B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dish-description{margin-top:12rpx;color:#94878C;font-size:23rpx;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.dish-meta{margin-top:16rpx;color:#B06B81;font-size:21rpx}.favorite{position:absolute;right:4rpx;top:20rpx;color:#B8ADB1;font-size:33rpx}.favorite.on{color:#E86F94}.add{position:absolute;right:0;bottom:24rpx;width:54rpx;height:54rpx;border-radius:50%;background:#FF8FAE;color:#fff;text-align:center;line-height:52rpx;font-size:38rpx;box-shadow:0 8rpx 18rpx rgba(232,111,148,.22)}.cart-float{position:fixed;height:104rpx;padding:0 20rpx 0 18rpx;border-radius:55rpx;background:#3F3438;color:#fff;display:flex;align-items:center;gap:10rpx;box-shadow:0 12rpx 30rpx rgba(63,52,56,.25);z-index:20;font-size:26rpx}.cart-icon{width:70rpx;height:70rpx;border-radius:50%;background:#fff;color:#E86F94;text-align:center;line-height:70rpx;font-size:40rpx}.drag-handle{color:#958A8E;font-size:30rpx;margin-left:2rpx}.cart-count{position:absolute;top:-5rpx;left:72rpx;min-width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border-radius:18rpx;background:#FF8FAE;font-size:20rpx}.bottom-space{height:160rpx}.error .btn{margin-top:24rpx}
