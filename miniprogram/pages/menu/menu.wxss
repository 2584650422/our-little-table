page {
  height: 100%;
  overflow: hidden;
  background: #fff;
}
.menu-page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #fff;
  position: relative;
}
.toolbar {
  height: 106rpx;
  flex: none;
  display: flex;
  align-items: center;
  padding: 0 27rpx 0 32rpx;
  gap: 20rpx;
}
.menu-title {
  font-size: 48rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
  color: #1d1d20;
}
.menu-caption {
  margin-left: auto;
  font-size: 22rpx;
  color: #8c898a;
}
.search-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.glass {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #525358;
  border-radius: 50%;
  position: relative;
}
.glass::after {
  content: '';
  position: absolute;
  width: 13rpx;
  height: 3rpx;
  background: #525358;
  right: -11rpx;
  bottom: -5rpx;
  transform: rotate(46deg);
  border-radius: 3rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  flex: none;
  height: 70rpx;
  margin: 0 24rpx 13rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f6f4f3;
}
.search-bar input {
  flex: 1;
  font-size: 25rpx;
}
.search-bar text {
  font-size: 23rpx;
  color: #ce7278;
}
.menu-body {
  flex: 1;
  min-height: 0;
  display: flex;
}
.category-rail {
  width: 155rpx;
  height: 100%;
  flex-shrink: 0;
  background: #fff;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.category {
  height: 100rpx;
  margin: 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: 25rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  color: #555257;
  position: relative;
}
.category.active {
  background: #fdeae9;
  color: #ce7175;
  font-weight: 650;
}
.category-name {
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.category-count {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  min-width: 27rpx;
  height: 27rpx;
  padding: 0 4rpx;
  border-radius: 50%;
  background: #d98082;
  color: #fff;
  text-align: center;
  line-height: 27rpx;
  font-size: 17rpx;
}
.dish-list {
  height: 100%;
  flex: 1;
  padding: 0 18rpx 0 9rpx;
  box-sizing: border-box;
}
.dish-row {
  display: flex;
  position: relative;
  min-height: 196rpx;
  padding: 8rpx 0 13rpx;
  box-sizing: border-box;
  align-items: flex-start;
}
.dish-image {
  width: 174rpx;
  height: 174rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #f4eeea;
}
.dish-info {
  min-width: 0;
  flex: 1;
  padding: 10rpx 58rpx 0 18rpx;
}
.dish-name {
  font-size: 27rpx;
  color: #28282a;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dish-description {
  margin-top: 11rpx;
  color: #969294;
  font-size: 21rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.dish-meta {
  margin-top: 15rpx;
  font-size: 19rpx;
  color: #b4a4a3;
}
.add {
  position: absolute;
  right: 6rpx;
  top: 70rpx;
  width: 55rpx;
  height: 55rpx;
  line-height: 54rpx;
  border-radius: 50%;
  background: #fce5e4;
  color: #ce6f73;
  text-align: center;
  font-size: 38rpx;
  font-weight: 300;
  transition: transform 0.15s ease;
}
.add:active {
  transform: scale(0.87);
}
.bottom-space {
  height: 155rpx;
}
.selected-bar {
  height: 107rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 20rpx 12rpx;
  padding: 0 11rpx 0 24rpx;
  background: #fff;
  border: 1rpx solid #f0ebe9;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 25rpx rgba(50, 40, 40, 0.08);
  box-sizing: border-box;
  position: relative;
  z-index: 5;
}
.selected-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  height: 100%;
}
.selected-text {
  font-size: 25rpx;
  color: #4b4849;
  font-weight: 620;
  white-space: nowrap;
}
.selected-thumbs {
  display: flex;
  align-items: center;
  margin-left: auto;
  padding-right: 8rpx;
}
.selected-thumbs image,
.selected-thumb-fallback {
  width: 49rpx;
  height: 49rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  margin-left: -13rpx;
  background: #f1ece8;
  box-sizing: border-box;
}
.selected-thumb-fallback {
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.selected-view {
  flex: none;
  width: 137rpx;
  height: 77rpx;
  line-height: 77rpx;
  border-radius: 999rpx;
  background: #dd7e80;
  color: #fff;
  font-size: 26rpx;
  margin: 0;
}
.selected-view::after {
  border: 0;
}
.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(22, 18, 18, 0.26);
  z-index: 10;
  opacity: 0;
  transition: opacity 0.22s ease;
}
.sheet-mask.is-open {
  opacity: 1;
}
.selected-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 18rpx 28rpx 28rpx;
  box-shadow: 0 -12rpx 36rpx rgba(48, 38, 42, 0.15);
  transform: translateY(105%);
  opacity: 0;
  transition:
    transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
    opacity 0.18s ease;
}
.selected-sheet.is-open {
  transform: translateY(0);
  opacity: 1;
}
.sheet-handle {
  width: 56rpx;
  height: 7rpx;
  background: #e5e1de;
  border-radius: 999rpx;
  margin: 0 auto 18rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: 31rpx;
  font-weight: 700;
}
.sheet-count {
  margin-left: 12rpx;
  color: #9b9390;
  font-size: 22rpx;
}
.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.clear {
  color: #b85f73;
  font-size: 23rpx;
}
.sheet-close {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f2efec;
  color: #918986;
  text-align: center;
  line-height: 34rpx;
  font-size: 34rpx;
}
.sheet-list {
  max-height: 420rpx;
  margin: 20rpx 0;
}
.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece7e4;
  font-size: 26rpx;
}
.sheet-dish-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-counter {
  display: flex;
  align-items: center;
  margin-left: 18rpx;
  gap: 10rpx;
}
.counter-button {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #f6e8e8;
  color: #b85f73;
  font-size: 31rpx;
}
.counter-button.plus {
  background: #e7798b;
  color: #fff;
}
.counter-value {
  min-width: 34rpx;
  text-align: center;
  color: #51494a;
  font-size: 25rpx;
}
.remove-selected {
  margin-left: 10rpx;
  color: #a89f9c;
  font-size: 20rpx;
}
.sheet-submit {
  width: 100%;
}
.error .btn {
  margin-top: 24rpx;
}

/* Reference-aligned warm palette and compact selection controls. */
.category.active {
  background: #fff0ee;
  color: #ce727a;
}
.category-count {
  background: #dd8388;
}
.dish-image.image-placeholder {
  background: #f8f3f0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-image.image-placeholder image {
  width: 75rpx;
  height: 75rpx;
  opacity: 0.78;
}
.dish-description {
  color: #8c898b;
}
.add {
  background: #ffe7e6;
  color: #d8787e;
}
.selected-bar {
  height: 104rpx;
  margin: 0 22rpx 17rpx;
  padding: 0 10rpx 0 22rpx;
  border-color: #f3eae8;
  border-radius: 999rpx;
  box-shadow: 0 7rpx 28rpx rgba(80, 58, 53, 0.08);
}
.selected-main {
  flex: 1;
  min-width: 0;
}
.selected-text {
  font-size: 24rpx;
}
.selected-thumbs {
  margin-left: auto;
  padding-right: 16rpx;
}
.selected-thumb-fallback {
  background: #f8f3f0;
}
.selected-thumb-fallback image {
  width: 35rpx;
  height: 35rpx;
  margin: 0;
  border: 0;
}
.selected-view {
  width: 133rpx;
  min-width: 133rpx;
  flex: 0 0 133rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 999rpx;
  background: #de7f84;
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}
.selected-view:active {
  opacity: 0.86;
}
.sheet-mask {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(48, 36, 37, 0.31);
}
.selected-sheet {
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  padding: 17rpx 30rpx 28rpx;
  background: #fffefd;
  box-shadow: 0 -15rpx 46rpx rgba(59, 38, 40, 0.13);
}
.sheet-handle {
  margin-bottom: 27rpx;
  background: #e6dfdc;
}
.sheet-head {
  align-items: flex-start;
}
.sheet-title {
  font-size: 33rpx;
  color: #302b2d;
  font-weight: 700;
}
.sheet-subtitle {
  font-size: 21rpx;
  color: #a19a98;
  margin-top: 9rpx;
}
.sheet-actions {
  gap: 22rpx;
}
.clear {
  color: #cb777d;
  font-size: 23rpx;
  line-height: 50rpx;
}
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 45rpx;
  background: #f8f3f1;
  color: #897f7e;
  font-size: 32rpx;
}
.sheet-list {
  max-height: 48vh;
  min-height: 116rpx;
  margin: 22rpx 0 14rpx;
}
.sheet-item {
  min-height: 123rpx;
  padding: 14rpx 0;
  gap: 12rpx;
  border-bottom: 1rpx solid #f2ece9;
}
.sheet-image {
  width: 90rpx;
  height: 90rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #f8f3f0;
}
.sheet-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-image-placeholder image {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.75;
}
.sheet-dish-copy {
  flex: 1;
  min-width: 0;
}
.sheet-dish-name {
  font-size: 26rpx;
  color: #383335;
  font-weight: 630;
}
.sheet-calorie {
  font-size: 20rpx;
  color: #a9a09e;
  margin-top: 8rpx;
}
.sheet-counter {
  margin-left: 0;
  gap: 5rpx;
  flex-shrink: 0;
}
.counter-button {
  width: 43rpx;
  height: 43rpx;
  line-height: 40rpx;
  background: #fff0ee;
  color: #c96f77;
}
.counter-button.plus {
  background: #de7f84;
}
.counter-value {
  min-width: 27rpx;
}
.remove-selected {
  width: 28rpx;
  flex-shrink: 0;
  text-align: right;
  margin-left: 2rpx;
  font-size: 27rpx;
  color: #b9afab;
}
.sheet-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2ece9;
  color: #918988;
  font-size: 22rpx;
}
.sheet-submit {
  width: 235rpx;
  height: 75rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 999rpx;
  background: #de7f84;
  color: #fff;
  font-size: 25rpx;
  font-weight: 650;
}
.sheet-submit text {
  font-size: 30rpx;
  font-weight: 300;
}

.food-links {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  color: #42664f;
  background: #e7ecdd;
  font-size: 25rpx;
  position: relative;
  z-index: 10;
}
.food-tools {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  background: #f7f5ee;
  position: relative;
  z-index: 10;
}
.food-tools text {
  padding: 11rpx 21rpx;
  border-radius: 18rpx;
  background: #fffef9;
  color: #42664f;
  font-size: 23rpx;
}
