/* Reference-aligned warm palette and compact selection controls. */
.category.active{background:#FFF0EE;color:#CE727A}
.category-count{background:#DD8388}
.dish-image.image-placeholder{background:#F8F3F0;display:flex;align-items:center;justify-content:center}
.dish-image.image-placeholder image{width:75rpx;height:75rpx;opacity:.78}
.dish-description{color:#8C898B}
.add{background:#FFE7E6;color:#D8787E}
.selected-bar{height:104rpx;margin:0 22rpx 17rpx;padding:0 10rpx 0 22rpx;border-color:#F3EAE8;border-radius:999rpx;box-shadow:0 7rpx 28rpx rgba(80,58,53,.08)}
.selected-main{flex:1;min-width:0}
.selected-text{font-size:24rpx}
.selected-thumbs{margin-left:auto;padding-right:16rpx}
.selected-thumb-fallback{background:#F8F3F0}
.selected-thumb-fallback image{width:35rpx;height:35rpx;margin:0;border:0}
.selected-view{width:133rpx;min-width:133rpx;flex:0 0 133rpx;height:76rpx;display:flex;align-items:center;justify-content:center;line-height:1;border-radius:999rpx;background:#DE7F84;color:#fff;font-size:25rpx;font-weight:600}
.selected-view:active{opacity:.86}
.sheet-mask{top:0;right:0;bottom:0;left:0;background:rgba(48,36,37,.31)}
.selected-sheet{box-sizing:border-box;border-radius:34rpx 34rpx 0 0;padding:17rpx 30rpx 28rpx;background:#FFFEFD;box-shadow:0 -15rpx 46rpx rgba(59,38,40,.13)}
.sheet-handle{margin-bottom:27rpx;background:#E6DFDC}
.sheet-head{align-items:flex-start}
.sheet-title{font-size:33rpx;color:#302B2D;font-weight:700}
.sheet-subtitle{font-size:21rpx;color:#A19A98;margin-top:9rpx}
.sheet-actions{gap:22rpx}
.clear{color:#CB777D;font-size:23rpx;line-height:50rpx}
.sheet-close{width:48rpx;height:48rpx;line-height:45rpx;background:#F8F3F1;color:#897F7E;font-size:32rpx}
.sheet-list{max-height:48vh;min-height:116rpx;margin:22rpx 0 14rpx}
.sheet-item{min-height:123rpx;padding:14rpx 0;gap:12rpx;border-bottom:1rpx solid #F2ECE9}
.sheet-image{width:90rpx;height:90rpx;flex-shrink:0;border-radius:18rpx;background:#F8F3F0}
.sheet-image-placeholder{display:flex;align-items:center;justify-content:center}
.sheet-image-placeholder image{width:52rpx;height:52rpx;opacity:.75}
.sheet-dish-copy{flex:1;min-width:0}
.sheet-dish-name{font-size:26rpx;color:#383335;font-weight:630}
.sheet-calorie{font-size:20rpx;color:#A9A09E;margin-top:8rpx}
.sheet-counter{margin-left:0;gap:5rpx;flex-shrink:0}
.counter-button{width:43rpx;height:43rpx;line-height:40rpx;background:#FFF0EE;color:#C96F77}
.counter-button.plus{background:#DE7F84}
.counter-value{min-width:27rpx}
.remove-selected{width:28rpx;flex-shrink:0;text-align:right;margin-left:2rpx;font-size:27rpx;color:#B9AFAB}
.sheet-footer{display:flex;align-items:center;justify-content:space-between;padding-top:20rpx;border-top:1rpx solid #F2ECE9;color:#918988;font-size:22rpx}
.sheet-submit{width:235rpx;height:75rpx;display:flex;align-items:center;justify-content:center;gap:14rpx;border-radius:999rpx;background:#DE7F84;color:#fff;font-size:25rpx;font-weight:650}
.sheet-submit text{font-size:30rpx;font-weight:300}
