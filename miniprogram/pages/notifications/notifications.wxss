.notifications-page {
  padding-bottom: 100rpx;
}
.page-title {
  font-size: 54rpx;
  line-height: 1.25;
  margin: 2rpx 3rpx 9rpx;
}
.page-caption {
  font-size: 23rpx;
  color: #879286;
  line-height: 1.5;
  margin: 0 3rpx 30rpx;
}
.subscribe-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 27rpx 27rpx;
  background: #e7ecdd;
  border-radius: 25rpx;
}
.subscribe-card-closed {
  background: #eef0e8;
}
.subscribe-card-closed .subscribe-title {
  color: #68776f;
}
.subscribe-title {
  font-size: 29rpx;
  font-weight: 670;
  color: #42664f;
}
.subscribe-card text {
  display: block;
  font-size: 22rpx;
  color: #798279;
  margin-top: 8rpx;
}
.chevron {
  font-size: 37rpx;
  color: #879286;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 38rpx 4rpx 15rpx;
}
.section-head text:first-child {
  font-size: 32rpx;
  font-weight: 700;
  color: #42664f;
}
.section-head text:last-child {
  font-size: 22rpx;
  color: #42664f;
}
.message-list {
  padding: 0 24rpx;
  border-radius: 25rpx;
}
.message-item {
  display: flex;
  align-items: center;
  gap: 17rpx;
  padding: 23rpx 0;
  border-bottom: 1rpx solid #eceee4;
}
.message-item:last-child {
  border-bottom: 0;
}
.message-dot {
  width: 13rpx;
  height: 13rpx;
  flex: none;
  border-radius: 50%;
  background: #42664f;
}
.message-dot.read {
  background: #dfe4d9;
}
.message-copy {
  flex: 1;
  min-width: 0;
}
.message-copy view {
  font-size: 27rpx;
  font-weight: 650;
  color: #303a33;
}
.message-copy > text {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #68776f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.message-copy .message-time {
  font-size: 20rpx;
  color: #879286;
}
.tip {
  font-size: 21rpx;
  color: #879286;
  line-height: 1.6;
  text-align: center;
  margin: 27rpx 23rpx;
}
.state {
  text-align: center;
  padding: 52rpx 18rpx;
  color: #68776f;
}
.state button {
  margin-top: 20rpx;
  border: 0;
  background: #e7ecdd;
  color: #42664f;
  border-radius: 999rpx;
  font-size: 23rpx;
}
.test-card {
  margin-top: 22rpx;
  padding: 25rpx;
  border-radius: 25rpx;
}
.test-heading {
  font-size: 27rpx;
  font-weight: 650;
  color: #303a33;
}
.test-caption {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #798279;
}
.test-actions {
  display: flex;
  gap: 15rpx;
  margin-top: 18rpx;
}
.test-button {
  flex: 1;
  margin: 0;
  padding: 0 10rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: 0;
  border-radius: 999rpx;
  background: #e7ecdd;
  color: #42664f;
  font-size: 21rpx;
}
.test-button[disabled] {
  opacity: 0.55;
}
.message-copy .readers {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
}
.message-copy .reader {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 400;
}
.reader-avatar {
  position: relative;
  flex: none;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #eef0e8;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  text-align: center;
  line-height: 38rpx;
}
.reader-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.reader-avatar > text {
  font-size: 21rpx;
  color: #68776f;
}
.reader-avatar.has-read {
  border-color: #42664f;
}
.reader-avatar .read-check {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  background: #42664f;
  color: white;
  border-radius: 50%;
  width: 21rpx;
  height: 21rpx;
  line-height: 21rpx;
  font-size: 16rpx;
  border: 2rpx solid white;
}
.reader .reader-status {
  font-size: 18rpx;
  color: #94878d;
}

.reminder-group {
  background: #fffef9;
  border-radius: 28rpx;
  padding: 4rpx 30rpx;
}
.reminder-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  padding: 26rpx 0;
  font-size: 27rpx;
}
.reminder-row + .reminder-row {
  border-top: 1rpx solid #e4e7dc;
}
.reminder-row > view {
  flex: none;
}
.reminder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}
.reminder-row text {
  display: block;
  font-size: 22rpx;
  color: #879286;
  margin-top: 10rpx;
  line-height: 1.6;
}
.reminder-row switch {
  transform: scale(0.8);
  transform-origin: right center;
}
.notifications-page .subscribe-card {
  background: #e7ecdd;
}
.notifications-page .subscribe-title {
  color: #42664f;
}
.notifications-page .subscribe-card text {
  color: #798279;
}

.reminder-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 52rpx;
}
.reminder-meta .reminder-count {
  margin-top: 0;
  flex: 1;
  min-width: 0;
}
.reminder-add {
  flex: none;
  width: 136rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #687f6b;
  background: transparent;
  border: 1rpx solid #d7ded2;
  border-radius: 12rpx;
}
.reminder-add::after {
  border: 0;
}
.reminder-add[disabled] {
  color: #a0a89d;
  border-color: #e4e7dc;
  background: transparent;
}
