.notifications-page{padding-bottom:100rpx}.page-title{font-size:54rpx;line-height:1.25;margin:2rpx 3rpx 9rpx}.page-caption{font-size:23rpx;color:#969097;line-height:1.5;margin:0 3rpx 30rpx}.subscribe-card{display:flex;align-items:center;justify-content:space-between;padding:27rpx 27rpx;background:#FFF5F4;border-radius:25rpx}.subscribe-card-closed{background:#F7F3F3}.subscribe-card-closed .subscribe-title{color:#777075}.subscribe-title{font-size:29rpx;font-weight:670;color:#383136}.subscribe-card text{display:block;font-size:22rpx;color:#9E858A;margin-top:8rpx}.chevron{font-size:37rpx;color:#A8A0A0}.section-head{display:flex;justify-content:space-between;align-items:center;margin:38rpx 4rpx 15rpx}.section-head text:first-child{font-size:32rpx;font-weight:700;color:#29262A}.section-head text:last-child{font-size:22rpx;color:#CF777E}.message-list{padding:0 24rpx;border-radius:25rpx}.message-item{display:flex;align-items:center;gap:17rpx;padding:23rpx 0;border-bottom:1rpx solid #F3EEEE}.message-item:last-child{border-bottom:0}.message-dot{width:13rpx;height:13rpx;flex:none;border-radius:50%;background:#DF7F86}.message-dot.read{background:#E7E1DF}.message-copy{flex:1;min-width:0}.message-copy view{font-size:27rpx;font-weight:650;color:#373136}.message-copy>text{display:block;margin-top:6rpx;font-size:23rpx;color:#8F878B;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message-copy .message-time{font-size:20rpx;color:#B2AAAE}.tip{font-size:21rpx;color:#A9A0A5;line-height:1.6;text-align:center;margin:27rpx 23rpx}.state{text-align:center;padding:52rpx 18rpx;color:#92898D}.state button{margin-top:20rpx;border:0;background:#F9EDEE;color:#C97880;border-radius:999rpx;font-size:23rpx}
