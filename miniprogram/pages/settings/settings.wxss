ht:520;flex:1}.link-arrow{font-size:35rpx;color:#A4A1A3;font-weight:300}.setup{text-align:center;padding:75rpx 30rpx}.setup-mark{font-size:56rpx;color:#D98287;margin-bottom:18rpx}.setup .btn{margin-top:30rpx}.error .btn{margin-top:24rpx}

