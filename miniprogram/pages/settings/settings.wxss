page {
  background: #f7f5ee;
}
.us-page {
  padding-bottom: 180rpx;
}
.us-page .life-title {
  margin-bottom: 30rpx;
}
.us-story {
  padding: 36rpx;
  border-radius: 36rpx;
  background: #e7ecdd;
  color: #283b34;
}
.us-story-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.us-story-label {
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #798279;
}

.us-name {
  font:
    500 48rpx/1.35 Georgia,
    'Songti SC',
    serif;
  margin-top: 28rpx;
}
.us-tagline {
  font-size: 25rpx;
  color: #617267;
  margin-top: 9rpx;
}
.us-people {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin: 34rpx 0 32rpx;
}
.us-person {
  min-width: 145rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 23rpx;
  color: #526658;
}
.us-avatar {
  width: 110rpx;
  height: 110rpx;
  border: 5rpx solid #fffef9;
  border-radius: 50%;
  overflow: hidden;
  background: #f7f5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-bottom: 9rpx;
}
.us-avatar image {
  width: 100%;
  height: 100%;
}
.us-avatar text {
  font:
    42rpx Georgia,
    'Songti SC',
    serif;
  color: #42664f;
}
.us-heart {
  font:
    46rpx Georgia,
    serif;
  color: #42664f;
}
.us-since {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #fffef9;
  font-size: 27rpx;
}
.us-since-label {
  display: block;
  color: #798279;
  font-size: 21rpx;
  margin-bottom: 5rpx;
}
.us-since > text {
  font-size: 42rpx;
  color: #42664f;
}
.us-section-title {
  font:
    500 34rpx Georgia,
    'Songti SC',
    serif;
  margin: 42rpx 4rpx 20rpx;
}
.us-shortcuts {
  display: flex;
  gap: 18rpx;
}
.us-shortcuts > view {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #fffef9;
}
.us-shortcuts image {
  display: block;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 20rpx;
}
.us-shortcuts text {
  display: block;
  font-size: 27rpx;
  color: #283b34;
}
.us-shortcuts view view {
  font-size: 22rpx;
  color: #798279;
  margin-top: 6rpx;
}
.us-list {
  padding: 2rpx 24rpx;
  border-radius: 28rpx;
  background: #fffef9;
}
.us-list-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  gap: 12rpx;
  border-bottom: 1rpx solid #e5e6dc;
}
.us-list-row:last-child {
  border-bottom: 0;
}
.us-list-row > view {
  flex: 1;
  min-width: 0;
}
.us-list-row > view > text {
  font-size: 27rpx;
  color: #283b34;
}
.us-list-row > view > view {
  font-size: 21rpx;
  color: #798279;
  margin-top: 5rpx;
  line-height: 1.4;
}
.us-list-row > text:last-child {
  font-size: 40rpx;
  color: #798279;
}
.us-unread {
  min-width: 33rpx;
  height: 33rpx;
  line-height: 33rpx;
  padding: 0 5rpx;
  border-radius: 99rpx;
  text-align: center;
  background: #b97461;
  color: #fffef9;
  font-size: 20rpx;
}
.us-food-note {
  margin: 34rpx 0 0;
  color: #42664f;
  font-size: 24rpx;
  text-align: center;
}
.us-empty {
  padding: 70rpx 25rpx;
  text-align: center;
  background: #fffef9;
  border-radius: 30rpx;
}
.us-empty-mark {
  font:
    72rpx Georgia,
    serif;
  color: #42664f;
}
.us-empty .life-button {
  margin: 28rpx auto 0;
}
