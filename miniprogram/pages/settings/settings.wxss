.setup{text-align:center;padding:60rpx 28rpx}.setup .btn{margin-top:30rpx}.profile{text-align:center;padding:44rpx 28rpx}.avatars{display:flex;justify-content:center;align-items:center;gap:18rpx;margin-bottom:24rpx}.person{display:flex;flex-direction:column;gap:10rpx;color:#8A7E82;font-size:22rpx}.person image,.avatar{width:100rpx;height:100rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#FFDCE6;color:#A96379;font-size:36rpx}.heart{color:#E86F94;font-size:34rpx}.stats{display:flex;gap:20rpx}.stats>view{flex:1;background:#fff;border-radius:24rpx;padding:28rpx;text-align:center}.stats text{display:block;font-size:22rpx;color:#8A7E82;margin-top:8rpx}.stats .stat-number{font-size:38rpx;color:#E86F94;margin-top:0}.links{padding-top:0;padding-bottom:0}.link-row{display:flex;align-items:center;justify-content:space-between;min-height:92rpx;padding:0 4rpx;border-bottom:2rpx solid #F8EEF1}.link-row:last-child{border:0}.link-main{display:flex;align-items:center;min-width:0}.link-icon{width:54rpx;margin-right:14rpx;text-align:center;color:#A96379;font-size:30rpx;line-height:1}.link-label{font-size:27rpx;color:#51464A}.link-arrow{color:#B8ADB1;font-size:34rpx}
