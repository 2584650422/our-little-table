<view class="page">
  <view wx:if="{{loading}}" class="loading">正在收拾小饭桌…</view>
  <view wx:elif="{{!couple}}" class="card setup"><view class="title">桌边还缺一个位置</view><view class="subtitle">创建或加入一个只属于你们的小饭桌</view><button class="btn" bindtap="couple">开始布置</button></view>
  <block wx:else>
    <view class="card profile">
      <view class="avatars"><block wx:for="{{couple.members}}" wx:key="id"><view class="person"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}"/><view wx:else class="avatar">{{item.nickname[0]}}</view><text>{{item.nickname}}</text></view><view wx:if="{{index===0&&couple.members.length>1}}" class="heart">♥</view></block></view>
      <view class="title">{{couple.name}}</view><view class="subtitle" wx:if="{{couple.anniversary}}">从 {{couple.anniversary}} 开始认真吃饭</view><view class="subtitle" wx:else>属于两个人的菜单和饭饭记录</view>
    </view>
    <view class="stats"><view bindtap="meals"><text class="stat-number">{{couple.stats.meals}}</text><text>一起吃过 ›</text></view><view bindtap="members"><text class="stat-number">{{couple.members.length}} / 2</text><text>饭桌成员 ›</text></view></view>
    <view class="section-title">我们的小东西</view>
    <view class="card links">
      <view class="link-row" bindtap="favorites"><view class="link-main"><text class="link-icon">♡</text><text class="link-label">我的收藏</text></view><text class="link-arrow">›</text></view>
      <view class="link-row" bindtap="manage"><view class="link-main"><text class="link-icon">☷</text><text class="link-label">菜单与分类管理</text></view><text class="link-arrow">›</text></view>
      <view class="link-row" bindtap="subscribe"><view class="link-main"><text class="link-icon">◌</text><text class="link-label">微信点菜提醒</text></view><text class="link-arrow">›</text></view>
      <view class="link-row" bindtap="coupleSettings"><view class="link-main"><text class="link-icon">⚙</text><text class="link-label">小饭桌设置</text></view><text class="link-arrow">›</text></view>
      <view class="link-row"><view class="link-main"><text class="link-icon">○</text><text class="link-label">关于两个人的小饭桌</text></view><text class="link-arrow">›</text></view>
    </view>
  </block>
</view>
