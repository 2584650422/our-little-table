<view class="page us-page" style="padding-top:{{topInset}}px">
  <view wx:if="{{loading}}" class="loading">正在收拾小饭桌…</view>
  <view wx:elif="{{error}}" class="card error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
  <view wx:elif="{{!couple}}" class="card setup"><view class="setup-mark">♡</view><view class="title">桌边还缺一个位置</view><view class="subtitle">创建或加入一个只属于你们的小饭桌</view><button class="btn" bindtap="couple">开始布置</button></view>
  <block wx:else>
    <view class="us-top"><image class="us-settings" src="/assets/icons/settings.png" mode="aspectFit" bindtap="coupleSettings"/></view>
    <view class="couple-profile"><view class="avatars"><view class="person"><image wx:if="{{couple.members[0].avatarUrl}}" src="{{couple.members[0].avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{couple.members[0].nickname[0]||'饭'}}</view></view><view class="couple-heart">♥</view><view wx:if="{{couple.members[1]}}" class="person"><image wx:if="{{couple.members[1].avatarUrl}}" src="{{couple.members[1].avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar second-avatar">{{couple.members[1].nickname[0]||'饭'}}</view></view><view wx:else class="person"><view class="avatar second-avatar">?</view></view></view><view class="couple-name">{{couple.name}}</view><view class="couple-subtitle">{{coupleSubtitle}}</view></view>
    <view class="stats"><view bindtap="meals"><text class="stat-number">{{couple.stats.meals||0}}</text><text>一起吃过</text></view><view bindtap="meals"><text class="stat-number">{{couple.stats.monthlyMeals||0}}</text><text>本月吃过</text></view><view bindtap="favorites"><text class="stat-number">{{favoriteCount}}</text><text>收藏菜谱</text></view></view>
    <view class="links"><view class="link-row" bindtap="favorites"><image class="link-icon-image" src="/assets/icons/heart.png" mode="aspectFit"/><text class="link-label">我们喜欢的菜</text><text class="link-arrow">›</text></view><view class="link-row" bindtap="manage"><image class="link-icon-image" src="/assets/icons/document.png" mode="aspectFit"/><text class="link-label">菜单管理</text><text class="link-arrow">›</text></view><view class="link-row" bindtap="meals"><image class="link-icon-image" src="/assets/icons/calendar.png" mode="aspectFit"/><text class="link-label">饮食小记录</text><text class="link-arrow">›</text></view><view class="link-row" bindtap="subscribe"><image class="link-icon-image" src="/assets/icons/bell.png" mode="aspectFit"/><text class="link-label">提醒设置</text><text class="link-arrow">›</text></view></view>
    <view class="links secondary-links"><view class="link-row" bindtap="members"><image class="link-icon-image" src="/assets/icons/members.png" mode="aspectFit"/><text class="link-label">成员管理</text><text class="link-arrow">›</text></view><view class="link-row" bindtap="about"><image class="link-icon-image" src="/assets/icons/info.png" mode="aspectFit"/><text class="link-label">关于我们</text><text class="link-arrow">›</text></view></view>
  </block>
</view>
