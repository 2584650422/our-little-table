<view class="page">
  <view class="hero">
    <view class="date">{{dateText}}</view>
    <view class="title">{{greeting}}，{{homeTitle}}</view>
    <view class="subtitle">{{homeSubtitle}}</view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在翻翻我们的小菜单…</view>
  <view wx:elif="{{error}}" class="card error"><view>{{error}}</view><button class="btn secondary" bindtap="bootstrap">重新试试</button></view>
  <view wx:elif="{{needsCouple}}" class="card bind-card">
    <view class="big">先把两把椅子摆好</view><view class="muted">创建或加入只属于你们的小饭桌</view><button class="btn" bindtap="goCouple">开始布置</button>
  </view>
  <block wx:else>
    <view class="random card">
      <view class="between"><view><view class="eyebrow">今晚要不要吃……</view><view class="section-name">不知道吃什么？交给小饭桌</view></view><view class="dice" bindtap="shuffle">↻</view></view>
      <view class="recommend-grid">
        <view wx:for="{{recommendations}}" wx:key="id" class="recommend" bindtap="detail" data-id="{{item.id}}">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="mini-placeholder">🍽️</view>
          <view class="recommend-name">{{item.name}}</view><view wx:if="{{item.calorieKcal}}" class="recommend-meta">约 {{item.calorieKcal}} kcal</view>
          <view class="mini-add" catchtap="add" data-id="{{item.id}}">就吃它</view>
        </view>
      </view>
      <button class="btn secondary" bindtap="shuffle">再换一组</button>
    </view>
    <view class="quick"><view class="quick-item" bindtap="goMenu">🍳<text>家常菜</text></view><view class="quick-item" bindtap="goMenu">🥬<text>清爽点</text></view><view class="quick-item" bindtap="goMenu">🍪<text>来点零食</text></view><view class="quick-item" bindtap="goMenu">🥤<text>喝点什么</text></view></view>
    <view class="section-title">最近一次点菜</view>
    <view wx:if="{{recent}}" class="card recent" bindtap="goOrders"><view class="between"><view>{{recent.mealDate}} · {{recent.mealLabel}}</view><order-status status="{{recent.status}}"/></view><view class="dish-line">{{recent.items[0].dishName}}<text wx:if="{{recent.items.length>1}}"> 等 {{recent.items.length}} 样</text></view><view class="muted">{{recent.creatorName}} 点的</view></view>
    <empty-state wx:else icon="🍚" title="还没有点过菜" hint="第一顿，就从今天开始吧"/>
    <view class="menu-guide" bindtap="goMenu"><view><view class="guide-title">还没决定今天吃什么？</view><text>去菜单里挑一挑</text></view><text class="guide-arrow">›</text></view>
  </block>
</view>
