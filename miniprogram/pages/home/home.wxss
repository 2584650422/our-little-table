.hero-progress {
  height: 7rpx;
  background: #fffef9;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 24rpx 0 16rpx;
}
.hero-progress > view {
  height: 100%;
  background: #42664f;
}

.modules {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin: 28rpx 0 34rpx;
}
.module-card {
  box-sizing: border-box;
  min-width: 0;
  min-height: 178rpx;
  padding: 18rpx 6rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background: #fffef9;
  border: 1rpx solid rgba(66, 102, 79, 0.07);
  border-radius: 22rpx;
  text-align: center;
}
.module-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.module-icon image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}
.module-title {
  width: 100%;
  color: #334c3d;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 600;
  white-space: nowrap;
}
.module-subtitle {
  width: 100%;
  margin-top: 2rpx;
  color: #879087;
  font-size: 19rpx;
  line-height: 28rpx;
  white-space: nowrap;
}
.thought-module-icon {
  box-sizing: border-box;
  position: relative;
  width: 36rpx;
  height: 30rpx;
  border: 3rpx solid #42664f;
  border-radius: 12rpx;
}
.thought-module-icon::after {
  content: '';
  position: absolute;
  left: 3rpx;
  bottom: -7rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #42664f;
  background: #fffef9;
  transform: skewY(-38deg);
}

.thought-module {
  position: relative;
}
.thought-unread-dot {
  position: absolute;
  z-index: 1;
  right: 12rpx;
  top: 12rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #b97461;
}
