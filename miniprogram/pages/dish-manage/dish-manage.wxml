<view class="prototype-page manage-page">
  <subpage-header/>
  <view class="heading"><text class="prototype-title">菜单管理</text><text class="category-link" bindtap="categories">分类管理 ›</text></view>
  <view class="manage-search"><view class="glass"></view><input value="{{keyword}}" placeholder="搜索想修改的菜" confirm-type="search" bindinput="input"/><text wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</text></view>
  <view wx:if="{{loading}}" class="loading">正在整理菜单…</view>
  <view wx:elif="{{error}}" class="error"><view>{{error}}</view><button class="btn secondary" bindtap="load">重新试试</button></view>
  <block wx:else>
    <view wx:for="{{dishes}}" wx:key="id" class="prototype-card dish-row {{!item.enabled?'disabled':''}}" bindtap="edit" data-id="{{item.id}}">
      <image wx:if="{{item.imageUrl}}" class="media-thumb" src="{{item.imageUrl}}" mode="aspectFill" lazy-load/>
      <view wx:else class="media-thumb media-placeholder"><image src="/assets/icons/dish-placeholder.png" mode="aspectFit"/></view>
      <view class="dish-copy"><view class="dish-name">{{item.name}}</view><view class="dish-meta">{{item.categoryName}} · 点过 {{item.orderedCount||0}} 次</view></view>
      <view wx:if="{{item.enabled && item.coupleId}}" class="down" catchtap="disable" data-id="{{item.id}}">下架</view>
      <text wx:elif="{{!item.enabled}}" class="off">已下架</text><text class="arrow">›</text>
    </view>
    <view wx:if="{{!dishes.length}}" class="empty">{{keyword?'没有找到这道菜':'菜单还空着，先加一道喜欢的菜吧'}}</view>
  </block>
  <view class="prototype-button prototype-fixed" bindtap="add">＋ 新增菜品</view>
</view>
