.manage-page{padding-bottom:175rpx}.heading{display:flex;align-items:baseline;justify-content:space-between;margin:4rpx 4rpx 25rpx}.category-link{font-size:25rpx;color:#D97479}.manage-search{height:72rpx;border-radius:25rpx;background:#F5F4F4;display:flex;align-items:center;padding:0 24rpx;margin-bottom:22rpx}.manage-search input{font-size:25rpx;flex:1;margin-left:20rpx;min-width:0}.glass{width:23rpx;height:23rpx;border:3rpx solid #8E929A;border-radius:50%;position:relative}.glass::after{content:'';position:absolute;width:13rpx;height:3rpx;background:#8E929A;right:-10rpx;bottom:-5rpx;transform:rotate(45deg)}.clear{font-size:34rpx;color:#A5A2A2;padding:0 10rpx}.dish-row{min-height:154rpx;padding:11rpx;display:flex;align-items:center;margin-bottom:11rpx}.dish-copy{flex:1;min-width:0;padding-left:20rpx}.dish-name{font-size:27rpx;font-weight:700;color:#222225;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dish-meta{font-size:21rpx;color:#99969C;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.down{width:76rpx;height:48rpx;line-height:45rpx;margin:0;background:#fff;color:#D8757A;border:1rpx solid #E58A8F;border-radius:999rpx;font-size:21rpx;padding:0}.down::after{border:0}.off{font-size:20rpx;color:#949399;background:#F2F1F1;padding:9rpx 12rpx;border-radius:999rpx}.arrow{color:#8B8C95;font-size:37rpx;margin:0 11rpx 0 14rpx}.disabled .dish-copy{opacity:.58}.error .btn{margin-top:20rpx}
.dish-row{min-height:190rpx}.dish-row .media-thumb{width:166rpx;height:166rpx;border-radius:20rpx}
.dish-copy{flex:1;min-width:0}
.down{width:124rpx;height:49rpx;flex:0 0 124rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:2rpx solid #E58A8F;border-radius:999rpx;font-size:22rpx;line-height:1;background:#fff;color:#D8757A;padding:0;margin:0}
.down:active{background:#FFF3F2}
