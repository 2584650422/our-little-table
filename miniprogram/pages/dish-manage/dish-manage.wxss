.manage-page {
  padding-bottom: 175rpx;
}
.heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 4rpx 4rpx 25rpx;
}
.category-link {
  font-size: 25rpx;
  color: #d97479;
}
.manage-search {
  height: 72rpx;
  border-radius: 25rpx;
  background: #f5f4f4;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 22rpx;
}
.manage-search input {
  font-size: 25rpx;
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.glass {
  width: 23rpx;
  height: 23rpx;
  border: 3rpx solid #8e929a;
  border-radius: 50%;
  position: relative;
}
.glass::after {
  content: '';
  position: absolute;
  width: 13rpx;
  height: 3rpx;
  background: #8e929a;
  right: -10rpx;
  bottom: -5rpx;
  transform: rotate(45deg);
}
.clear {
  font-size: 34rpx;
  color: #a5a2a2;
  padding: 0 10rpx;
}
.dish-row {
  min-height: 154rpx;
  padding: 11rpx;
  display: flex;
  align-items: center;
  margin-bottom: 11rpx;
}
.dish-copy {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}
.dish-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #222225;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dish-meta {
  font-size: 21rpx;
  color: #99969c;
  margin-top: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.down {
  width: 76rpx;
  height: 48rpx;
  line-height: 45rpx;
  margin: 0;
  background: #fff;
  color: #d8757a;
  border: 1rpx solid #e58a8f;
  border-radius: 999rpx;
  font-size: 21rpx;
  padding: 0;
}
.down::after {
  border: 0;
}
.off {
  font-size: 20rpx;
  color: #949399;
  background: #f2f1f1;
  padding: 9rpx 12rpx;
  border-radius: 999rpx;
}
.arrow {
  color: #8b8c95;
  font-size: 37rpx;
  margin: 0 11rpx 0 14rpx;
}
.disabled .dish-copy {
  opacity: 0.58;
}
.error .btn {
  margin-top: 20rpx;
}
.dish-row {
  min-height: 190rpx;
}
.dish-row .media-thumb {
  width: 166rpx;
  height: 166rpx;
  border-radius: 20rpx;
}
.dish-copy {
  flex: 1;
  min-width: 0;
}
.down {
  width: 124rpx;
  height: 49rpx;
  flex: 0 0 124rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e58a8f;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  background: #fff;
  color: #d8757a;
  padding: 0;
  margin: 0;
}
.down:active {
  background: #fff3f2;
}
.off-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  margin-left: 12rpx;
}
.manage-action {
  margin: 0;
  width: 124rpx;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0;
  font-size: 21rpx;
  border-radius: 999rpx;
}
.manage-action::after {
  border: 0;
}
.restore {
  background: #fff0f4;
  color: #c36983;
}
.remove {
  background: #f4f1f1;
  color: #947b7d;
}
.off {
  font-size: 19rpx;
  padding: 4rpx 12rpx;
}
