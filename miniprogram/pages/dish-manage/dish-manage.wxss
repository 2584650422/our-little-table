.manage-head{display:flex;align-items:center;justify-content:space-between;margin:0 6rpx 20rpx}.tip{font-size:23rpx;color:#8A7E82;flex:1}.head-actions{display:flex;align-items:center}.category-link{font-size:24rpx;color:#E86F94;margin-left:16rpx;white-space:nowrap}.search-icon{width:60rpx;height:60rpx;border-radius:18rpx;background:#FFE8EF;color:#C45F7D;font-size:39rpx;line-height:56rpx;text-align:center;box-shadow:0 6rpx 14rpx rgba(232,111,148,.12)}.manage-search{height:68rpx;border-radius:16rpx;background:#F8F4F5;display:flex;align-items:center;padding:0 18rpx;margin:0 6rpx 20rpx}.manage-search input{flex:1;font-size:25rpx}.manage-search text{font-size:34rpx;color:#A99CA0}.row-item{display:flex;align-items:center}.row-item image,.thumb{width:100rpx;height:100rpx;border-radius:18rpx}.info{flex:1;margin-left:20rpx}.info view{font-weight:600}.info text{font-size:22rpx;color:#8A7E82}.down{min-width:52rpx;height:42rpx;line-height:40rpx;background:#FFF0F4;color:#A96379;border-radius:11rpx;font-size:20rpx;padding:0 8rpx}.down::after{border:0}.disabled{opacity:.55}
