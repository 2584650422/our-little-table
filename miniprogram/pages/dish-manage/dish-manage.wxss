.manage-head{display:flex;align-items:center;justify-content:space-between;margin:0 6rpx 24rpx}.tip{font-size:23rpx;color:#8A7E82;flex:1}.category-link{font-size:24rpx;color:#E86F94;margin-left:20rpx;white-space:nowrap}.row-item{display:flex;align-items:center}.row-item image,.thumb{width:100rpx;height:100rpx;border-radius:18rpx}.info{flex:1;margin-left:20rpx}.info view{font-weight:600}.info text{font-size:22rpx;color:#8A7E82}.down{background:#FFF0F4;color:#A96379;border-radius:999rpx;font-size:22rpx;padding:10rpx 18rpx}.down::after{border:0}.disabled{opacity:.55}
