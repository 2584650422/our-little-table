.compose-mask {
  position: fixed;
  inset: 0;
  background: #26332a69;
  z-index: 1200;
}
.compose-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fffef9;
  border-radius: 46rpx 46rpx 0 0;
  padding: 20rpx 44rpx max(40rpx, env(safe-area-inset-bottom));
  color: #283b34;
}
.handle {
  width: 60rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #dfdfd7;
  margin: 0 auto 30rpx;
}
.compose-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 38rpx;
  font-weight: 600;
}
.close {
  padding: 8rpx 10rpx;
  color: #879286;
  font-size: 46rpx;
}
.people {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin: 24rpx 0 32rpx;
  color: #879286;
}
.people view {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #e7ecdd;
  border-radius: 50%;
  color: #42664f;
}
.people view:last-child {
  background: #eee6dc;
  color: #79634e;
}
.input-wrap {
  border: 1rpx solid #dfe2d8;
  border-radius: 24rpx;
  padding: 24rpx;
}
.input-wrap textarea {
  width: 100%;
  height: 170rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.input-wrap > text {
  display: block;
  text-align: right;
  color: #879286;
  font-size: 21rpx;
}
.presets {
  display: flex;
  gap: 14rpx;
  margin: 26rpx 0 38rpx;
}
.presets text {
  padding: 14rpx 22rpx;
  border: 1rpx solid #e5e6dc;
  border-radius: 40rpx;
  background: #f7f5ee;
  font-size: 24rpx;
}
.send {
  background: #42664f;
  color: #fffef9;
  border: 0;
  border-radius: 20rpx;
  font-size: 30rpx;
}
.send::after {
  border: 0;
}
.hint {
  text-align: center;
  color: #879286;
  font-size: 21rpx;
  margin: 20rpx 0;
}
