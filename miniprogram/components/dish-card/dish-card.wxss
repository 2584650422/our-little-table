.dish{background:#fff;border-radius:28rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 8rpx 28rpx rgba(123,77,91,.06)}.photo{width:100%;height:300rpx;display:flex}.placeholder{background:#FFF0F4;align-items:center;justify-content:center;font-size:76rpx}.content{padding:24rpx}.between,.bottom{display:flex;justify-content:space-between;align-items:center}.name{font-size:32rpx;font-weight:700}.heart{font-size:42rpx;color:#E86F94;padding:0 4rpx}.desc{font-size:25rpx;color:#8A7E82;margin:10rpx 0}.meta{font-size:23rpx;color:#A96379}.tags{display:flex;gap:8rpx;flex:1;overflow:hidden;margin-top:18rpx}.tag{font-size:20rpx;background:#FFF0F4;color:#A96379;border-radius:999rpx;padding:6rpx 12rpx;white-space:nowrap}.add{margin:16rpx 0 0 12rpx;background:#FF8FAE;color:#fff;font-size:23rpx;border-radius:999rpx;padding:12rpx 20rpx;line-height:1.2}.add::after{border:0}
