<view class="dish" bindtap="detail"><image wx:if="{{dish.imageUrl}}" class="photo" mode="aspectFill" src="{{dish.imageUrl}}"/><view wx:else class="photo placeholder">🍽️</view><view class="content"><view class="between"><view class="name">{{dish.name}}</view><view class="heart" catchtap="favorite">{{dish.isFavorite?'♥':'♡'}}</view></view><view class="desc">{{dish.description||'今天也值得好好吃饭'}}</view><view class="meta"><text wx:if="{{dish.calorieKcal}}">约 {{dish.calorieKcal}} kcal</text><text wx:if="{{dish.cookTimeMinutes}}"> · {{dish.cookTimeMinutes}} min</text></view><view class="bottom"><view class="tags"><text class="tag" wx:for="{{dish.tags}}" wx:key="*this">{{item}}</text></view><button class="add" catchtap="add">+ 想吃</button></view></view></view>
