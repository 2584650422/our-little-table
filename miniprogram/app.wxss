page{background:#FAF9F6;color:#262326;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx} .page{min-height:100vh;padding:28rpx 28rpx 150rpx;box-sizing:border-box}.card{background:#fff;border-radius:28rpx;padding:28rpx;box-shadow:0 8rpx 28rpx rgba(48,38,42,.045);margin-bottom:24rpx;transition:transform .18s ease,box-shadow .18s ease}.title{font-size:38rpx;font-weight:700}.subtitle{font-size:25rpx;color:#8A8583;margin-top:8rpx}.muted{color:#8A8583}.light{color:#B7B0AE}.pink{color:#E7798B}.row{display:flex;align-items:center}.between{display:flex;align-items:center;justify-content:space-between}.wrap{display:flex;flex-wrap:wrap;gap:12rpx}.btn{display:flex;align-items:center;justify-content:center;background:#E7798B;color:#fff;border-radius:999rpx;font-size:28rpx;font-weight:600;padding:22rpx 34rpx;line-height:1.2;border:0;transition:transform .16s ease,opacity .16s ease,box-shadow .16s ease}.btn:active{transform:scale(.975);opacity:.9}.btn::after{border:0}.btn.secondary{background:#FBECEE;color:#C6677A}.btn.ghost{background:#fff;color:#C6677A;border:2rpx solid #F2D9DE}.btn.small{padding:14rpx 24rpx;font-size:24rpx}.tag{background:#FBECEE;color:#B76577;border-radius:999rpx;padding:8rpx 16rpx;font-size:22rpx}.section-title{font-size:32rpx;font-weight:700;margin:36rpx 4rpx 20rpx}.input{height:84rpx;line-height:84rpx;background:#fff;border-radius:24rpx;padding:0 26rpx;box-sizing:border-box;width:100%;font-size:28rpx;transition:background .18s ease,box-shadow .18s ease}.input:focus{background:#FFFDFE;box-shadow:0 0 0 3rpx #F7E1E5}.field{margin-bottom:24rpx}.label{display:block;font-size:24rpx;color:#8A8583;margin:0 0 12rpx 6rpx}.empty{text-align:center;padding:80rpx 30rpx;color:#8A8583}.empty-icon{font-size:76rpx;margin-bottom:20rpx}.fab{position:fixed;right:30rpx;bottom:150rpx;background:#E7798B;color:#fff;border-radius:999rpx;padding:22rpx 30rpx;box-shadow:0 12rpx 30rpx rgba(231,121,139,.22);z-index:9;transition:transform .16s ease}.fab:active{transform:scale(.95)}.image-placeholder{background:#F6F1EE;color:#B6A8A5;display:flex;align-items:center;justify-content:center}.loading{text-align:center;color:#8A8583;padding:80rpx}.error{text-align:center;padding:60rpx}.divider{height:2rpx;background:#F0EBE9;margin:24rpx 0}

/* Warm cream and muted coral used across the prototype. */
page{background:#FFFCFB;color:#29272A}
.pink{color:#DE7F84}
.btn,.fab{background:#DE7F84}
.btn.secondary{background:#FCF4F3;color:#BD6C74}
.btn.ghost{color:#BD6C74;border-color:#F1DCDA}
.tag{background:#FFF0EE;color:#B96E75}
.image-placeholder{background:#F8F3F0;color:#BDAEA5}
