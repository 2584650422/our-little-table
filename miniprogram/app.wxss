page{background:#FFF7FA;color:#3F3438;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:28rpx 28rpx 150rpx;box-sizing:border-box}.card{background:#fff;border-radius:28rpx;padding:28rpx;box-shadow:0 8rpx 28rpx rgba(123,77,91,.06);margin-bottom:24rpx}.title{font-size:38rpx;font-weight:700}.subtitle{font-size:25rpx;color:#8A7E82;margin-top:8rpx}.muted{color:#8A7E82}.light{color:#B8ADB1}.pink{color:#E86F94}.row{display:flex;align-items:center}.between{display:flex;align-items:center;justify-content:space-between}.wrap{display:flex;flex-wrap:wrap;gap:12rpx}.btn{display:flex;align-items:center;justify-content:center;background:#FF8FAE;color:#fff;border-radius:999rpx;font-size:28rpx;font-weight:600;padding:22rpx 34rpx;line-height:1.2;border:0}.btn::after{border:0}.btn.secondary{background:#FFF0F4;color:#E86F94}.btn.ghost{background:#fff;color:#E86F94;border:2rpx solid #FFDCE6}.btn.small{padding:14rpx 24rpx;font-size:24rpx}.tag{background:#FFF0F4;color:#A96379;border-radius:999rpx;padding:8rpx 16rpx;font-size:22rpx}.section-title{font-size:32rpx;font-weight:700;margin:36rpx 4rpx 20rpx}.input{background:#fff;border-radius:24rpx;padding:22rpx 26rpx;box-sizing:border-box;width:100%}.field{margin-bottom:24rpx}.label{display:block;font-size:24rpx;color:#8A7E82;margin:0 0 12rpx 6rpx}.empty{text-align:center;padding:80rpx 30rpx;color:#8A7E82}.empty-icon{font-size:76rpx;margin-bottom:20rpx}.fab{position:fixed;right:30rpx;bottom:150rpx;background:#E86F94;color:#fff;border-radius:999rpx;padding:22rpx 30rpx;box-shadow:0 12rpx 30rpx rgba(232,111,148,.3);z-index:9}.image-placeholder{background:#FFF0F4;color:#C8899D;display:flex;align-items:center;justify-content:center}.loading{text-align:center;color:#8A7E82;padding:80rpx}.error{text-align:center;padding:60rpx}.divider{height:2rpx;background:#F4E4EA;margin:24rpx 0}
